---
import Eyebrow from './Eyebrow.astro';
import TargetIcon from './icons/TargetIcon.astro';

export interface Milestone {
  value: string;
  label: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  items: Milestone[];
  id?: string;
}
const { eyebrow = 'Since 1957', title, items, id } = Astro.props;
---
<!--
  The "since 1957" band. A rule runs through five ring nodes and draws itself
  in when the section arrives, with the milestones staggering up behind it.
  Deliberately not a pinned, scroll-scrubbed set piece: pinning fights the
  reader, breaks the moment a viewport is short, and has nothing to fall back
  on. This is the same idea with plain CSS and one IntersectionObserver, so it
  behaves identically on a phone, on a laptop, and with motion turned off.
-->
<section class="milestones tone-pine" id={id} aria-labelledby="milestones-title">
  <div class="milestones__watermark" aria-hidden="true">
    <TargetIcon size={760} strokeWidth={0.3} />
  </div>

  <div class="wrap milestones__inner">
    <header class="milestones__head" data-reveal>
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 id="milestones-title" class="shot-head">{title}</h2>
    </header>

    <ol class="milestones__rail" data-milestones>
      <span class="milestones__rule" aria-hidden="true"></span>
      {items.map((item, i) => (
        <li class="milestone" data-reveal style={`--reveal-delay:${240 + i * 130}ms`}>
          <span class="milestone__node" aria-hidden="true"></span>
          <span class="milestone__value num">{item.value}</span>
          <span class="milestone__label">{item.label}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .milestones {
    position: relative;
    background: var(--pine-900);
    color: var(--cream-50);
    padding-block: calc(var(--section-y) * 1.15);
    overflow: hidden;
    isolation: isolate;
  }

  .milestones__watermark {
    position: absolute;
    top: 50%;
    right: -16rem;
    translate: 0 -50%;
    color: var(--sage-300);
    opacity: 0.06;
    pointer-events: none;
  }
  .milestones__watermark :global(svg) { width: 44rem; height: 44rem; }

  .milestones__inner { position: relative; }

  .milestones__head { max-width: 34rem; margin-bottom: clamp(3rem, 2rem + 4vw, 5rem); }
  .milestones__head h2 {
    color: var(--cream-50);
    font-size: clamp(1.875rem, 1.4rem + 2.2vw, 3.25rem);
    font-weight: 300;
  }

  /* ------------------------------------------------------------------ rail */
  .milestones__rail {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-7);
  }
  @media (min-width: 56rem) {
    .milestones__rail {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: clamp(1.25rem, 0.3rem + 2vw, 2.75rem);
    }
  }

  /* The rule the nodes sit on: vertical on narrow, horizontal from 56rem. */
  .milestones__rule {
    position: absolute;
    left: 0.6rem;
    top: 0.35rem;
    bottom: 0.35rem;
    width: 1px;
    /* Fades out past the last node, so the run reads as continuing rather
       than stopping short of the grid edge. */
    background: linear-gradient(
      to bottom,
      rgba(248, 245, 238, 0.22) 0%,
      rgba(248, 245, 238, 0.22) 84%,
      rgba(248, 245, 238, 0) 100%
    );
    transform-origin: top;
    scale: 1 0;
    transition: scale 1200ms var(--ease) 120ms;
  }
  @media (min-width: 56rem) {
    .milestones__rule {
      left: 0;
      right: 0;
      top: 0.62rem;
      bottom: auto;
      width: auto;
      height: 1px;
      background: linear-gradient(
        to right,
        rgba(248, 245, 238, 0.22) 0%,
        rgba(248, 245, 238, 0.22) 82%,
        rgba(248, 245, 238, 0) 100%
      );
      transform-origin: left;
      scale: 0 1;
    }
  }
  .milestones__rail[data-drawn] .milestones__rule { scale: 1 1; }

  /* -------------------------------------------------------------- milestone */
  .milestone {
    position: relative;
    padding-left: 2.25rem;
    display: grid;
    align-content: start;
    gap: var(--sp-2);
  }
  @media (min-width: 56rem) {
    .milestone { padding-left: 0; padding-top: 2.5rem; }
  }

  .milestone__node {
    position: absolute;
    left: 0;
    top: 0.1rem;
    width: 1.25rem;
    height: 1.25rem;
    border: 1.5px solid var(--ember);
    border-radius: 999px;
    background: var(--pine-900);
  }
  .milestone__node::after {
    content: '';
    position: absolute;
    inset: 0.3rem;
    border-radius: 999px;
    background: var(--ember);
    scale: 0;
    transition: scale var(--dur) var(--ease);
  }
  /* The bullseye at the end of the run is the only red on the page. */
  .milestone:last-child .milestone__node { border-color: var(--bullseye); }
  .milestone:last-child .milestone__node::after { background: var(--bullseye); }
  .milestone.is-revealed .milestone__node::after { scale: 1; }
  @media (min-width: 56rem) {
    .milestone__node { top: 0; left: 0; }
  }

  .milestone__value {
    font-size: clamp(2.75rem, 1.6rem + 3.6vw, 5rem);
    color: var(--ember);
    line-height: 0.9;
  }
  .milestone:last-child .milestone__value { color: var(--cream-50); }

  .milestone__label {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: rgba(248, 245, 238, 0.76);
    max-width: 24ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .milestones__rule { scale: 1 1; transition: none; }
    .milestone__node::after { scale: 1; transition: none; }
  }
</style>

<script>
  function drawRails() {
    const rails = document.querySelectorAll<HTMLElement>('[data-milestones]');
    if (!rails.length) return;

    if (!('IntersectionObserver' in window)) {
      rails.forEach((r) => r.setAttribute('data-drawn', ''));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.setAttribute('data-drawn', '');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -18% 0px', threshold: 0.15 },
    );
    rails.forEach((r) => io.observe(r));
  }

  drawRails();
  document.addEventListener('astro:after-swap', drawRails);
</script>
