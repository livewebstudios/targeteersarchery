---
/**
 * The top of every inner page: one clear-glass card. Eyebrow, the page's one
 * H1, the lead, and any actions in the slot. With a photo, Rob's own shot sits
 * inside the card beside the copy (landscapes go behind the glass, his photos
 * go inside it). The photo is eager and high priority: it is the page's
 * largest image after the backdrop.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Eyebrow from '../Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Kept for older call sites. One skin now. */
  tone?: 'pine' | 'cream' | 'bark';
  variant?: 'photo' | 'plain';
  focus?: string;
}
const {
  eyebrow, title, lead, image, imageAlt = '',
  variant = image ? 'photo' : 'plain', focus = '50% 50%',
} = Astro.props;
const withPhoto = variant === 'photo' && image;
---
<section class="page-hero" aria-labelledby="page-title">
  <div class="wrap">
    <div class={`page-hero__card glass ${withPhoto ? 'has-photo' : ''}`}>
      <div class="page-hero__copy">
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        <h1 id="page-title">{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </div>
      {withPhoto && (
        <div class="page-hero__media">
          <Picture src={image} alt={imageAlt} formats={['avif', 'webp']}
            widths={[480, 720, 960, 1280]} sizes="(max-width: 60rem) 92vw, 34rem"
            loading="eager" fetchpriority="high" style={`object-position:${focus}`} />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero__card {
    display: grid;
    gap: var(--sp-6);
    padding: var(--panel-pad);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .page-hero__card.has-photo {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--sp-7);
      padding: clamp(1.25rem, 0.7rem + 1.6vw, 2rem) clamp(1.25rem, 0.7rem + 1.6vw, 2rem) clamp(1.25rem, 0.7rem + 1.6vw, 2rem) var(--panel-pad);
    }
  }
  .page-hero__copy { display: grid; justify-items: start; gap: var(--sp-4); }
  .page-hero__copy :global(.eyebrow) { margin: 0; }
  .page-hero__copy h1 { max-width: 22ch; font-size: clamp(2rem, 1.45rem + 2.1vw, 3.375rem); }
  .page-hero__copy .lead { margin: 0; }
  .page-hero__copy > :global(:not(.eyebrow, h1, .lead)) { margin-top: var(--sp-2); }

  .page-hero__media { order: -1; border-radius: 18px; overflow: hidden; aspect-ratio: 16 / 10; }
  @media (min-width: 60rem) {
    .page-hero__media { order: 0; aspect-ratio: 5 / 4; }
  }
  .page-hero__media :global(picture),
  .page-hero__media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
