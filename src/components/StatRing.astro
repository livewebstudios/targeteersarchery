---
interface Props { value: string; label: string; note?: string; }
const { value, label, note } = Astro.props;
---
<div class="stat" data-reveal>
  <svg class="stat__ring" viewBox="0 0 100 100" fill="none" aria-hidden="true">
    <circle cx="50" cy="50" r="47" stroke="currentColor" stroke-width="0.5" opacity=".55" />
    <circle cx="50" cy="50" r="35" stroke="currentColor" stroke-width="0.5" opacity=".42" />
    <circle cx="50" cy="50" r="23" stroke="currentColor" stroke-width="0.5" opacity=".3" />
    <circle cx="50" cy="50" r="11" stroke="currentColor" stroke-width="0.5" opacity=".2" />
  </svg>
  <p class="stat__value num">{value}</p>
  <p class="stat__label">{label}</p>
  {note && <p class="stat__note">{note}</p>}
</div>

<style>
  .stat { position: relative; padding: var(--sp-6) 0 var(--sp-5); isolation: isolate; }
  .stat__ring {
    position: absolute;
    top: -1.5rem;
    left: -3.5rem;
    width: 15rem;
    height: 15rem;
    color: var(--accent, var(--ember));
    opacity: 0.45;
    pointer-events: none;
    z-index: -1;
  }
  /* On the dark bands a cream ring at full strength competes with the numeral. */
  .tone-pine .stat__ring,
  .tone-bark .stat__ring { opacity: 0.3; }
  .stat__value { font-size: clamp(3rem, 1.6rem + 4.6vw, 6rem); color: var(--fg); margin: 0; }
  .stat__label {
    margin: var(--sp-3) 0 0;
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent, var(--ember));
  }
  .stat__note { margin: var(--sp-2) 0 0; font-size: var(--fs-small); color: var(--fg-muted); max-width: 26ch; }
</style>
