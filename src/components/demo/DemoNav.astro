---
/**
 * The simplified nav. Five plain links, no dropdowns, no panels, no sub-nav.
 * One component, three skins: smoke, frost, clear.
 *
 * Wide: a floating glass pill 16px off the top. Logo, five links, the open
 * pill, and the one orange button. Below 72rem: logo, a phone button, a menu
 * button. The menu lists the same five links plus CONTACT, all visible.
 */
import { Image } from 'astro:assets';
import logoRGB from '~/assets/brand/logoRGB.png';
import { business } from '~/data/business';
import { demoNav } from '~/data/home';
import OpenNowPill from '~/components/OpenNowPill.astro';
import PhoneIcon from '~/components/icons/PhoneIcon.astro';

interface Props {
  variant: 'smoke' | 'frost' | 'clear';
  /** The logo links to the demo itself. */
  home: string;
}
const { variant, home } = Astro.props;
const menuId = `demo-menu-${variant}`;
---
<header class={`demo-nav demo-nav--${variant}`} data-demo-nav>
  <div class={`demo-nav__pill glass-${variant}`}>
    <a class="demo-nav__logo" href={home} aria-label={`${business.shortName}, top of the page`}>
      <Image src={logoRGB} alt="Targeteers Archery" widths={[240, 480]} sizes="170px" loading="eager" />
    </a>

    <nav class="demo-nav__links" aria-label="Main">
      <ul>
        {demoNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="demo-nav__end">
      <span class="demo-nav__open"><OpenNowPill compact /></span>
      <a class="d-btn d-btn--orange demo-nav__call" href={business.phoneHref} data-nav-call>
        <PhoneIcon size={16} />
        <span>CALL {business.phone}</span>
      </a>
      <a class="demo-nav__icon" href={business.phoneHref} aria-label={`Call the shop, ${business.phone}`}>
        <PhoneIcon size={20} />
      </a>
      <button class="demo-nav__icon demo-nav__menu" type="button" aria-haspopup="dialog" aria-controls={menuId} data-menu-open>
        <span class="demo-nav__bars" aria-hidden="true"><span></span><span></span></span>
        <span class="visually-hidden">Open the menu</span>
      </button>
    </div>
  </div>

  <dialog class={`demo-menu demo-menu--${variant} glass-${variant}`} id={menuId} aria-label="Menu" data-menu>
    <div class="demo-menu__head">
      <a class="demo-nav__logo" href={home}>
        <Image src={logoRGB} alt="Targeteers Archery" widths={[240, 480]} sizes="170px" loading="lazy" />
      </a>
      <button class="demo-nav__icon" type="button" data-menu-close>
        <span class="demo-menu__x" aria-hidden="true"></span>
        <span class="visually-hidden">Close the menu</span>
      </button>
    </div>
    <nav aria-label="Menu links">
      <ul class="demo-menu__links">
        {demoNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/contact/">CONTACT</a></li>
      </ul>
    </nav>
    <div class="demo-menu__foot">
      <OpenNowPill />
      <a class="d-btn d-btn--orange" href={business.phoneHref}>
        <PhoneIcon size={16} /><span>CALL {business.phone}</span>
      </a>
    </div>
  </dialog>
</header>

<style>
  .demo-nav {
    position: sticky;
    top: 16px;
    z-index: 80;
    width: 100%;
    max-width: var(--wrap);
    margin: 16px auto 0;
    padding-inline: var(--gutter);
  }
  .demo-nav__pill {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: 0.6rem 0.6rem 0.6rem 0.75rem;
    border-radius: 999px;
    transition: padding var(--dur) var(--ease);
  }
  .demo-nav--clear .demo-nav__pill { border-radius: 6px; }
  .demo-nav[data-scrolled] .demo-nav__pill { padding-block: 0.35rem; }

  /* ---------------------------------------------------------------- logo
     Never on glass that muddies the navy: it always sits on its own plate. */
  .demo-nav__logo {
    flex: none;
    display: block;
    background: #fff;
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    line-height: 0;
    transition: padding var(--dur) var(--ease);
  }
  .demo-nav--clear .demo-nav__logo { border-radius: 4px; }
  .demo-nav__logo :global(img) {
    width: auto;
    height: 3rem;
    transition: height var(--dur) var(--ease);
  }
  .demo-nav[data-scrolled] .demo-nav__logo :global(img) { height: 2.5rem; }
  @media (min-width: 72rem) {
    .demo-nav__logo :global(img) { height: 3.5rem; }
    .demo-nav[data-scrolled] .demo-nav__logo :global(img) { height: 2.875rem; }
  }

  /* --------------------------------------------------------------- links */
  .demo-nav__links { display: none; }
  .demo-nav__links ul {
    display: flex;
    gap: clamp(0.75rem, 0.1rem + 0.9vw, 1.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .demo-nav__links a,
  .demo-menu__links a {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
    background: linear-gradient(var(--tgt-orange), var(--tgt-orange)) left bottom / 0 2px no-repeat;
    padding-block: 0.5rem;
    transition: background-size var(--dur-fast) var(--ease);
  }
  .demo-nav__links a:hover { background-size: 100% 2px; }

  .demo-nav__end {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .demo-nav__open { display: none; }
  .demo-nav__call { display: none; }

  /* When an orange button is already on screen in the page itself, the nav's
     own call button steps down to an outline: one orange per viewport. */
  .demo-nav[data-quiet] .demo-nav__call {
    background: transparent;
    color: var(--ink);
    border-color: var(--outline);
  }

  .demo-nav__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--hair-strong);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    padding: 0;
  }
  .demo-nav--clear .demo-nav__icon { border-radius: 4px; }
  .demo-nav__bars { display: grid; gap: 5px; width: 18px; }
  .demo-nav__bars span { display: block; height: 2px; background: currentColor; border-radius: 2px; }

  @media (min-width: 72rem) {
    .demo-nav__links { display: block; }
    .demo-nav__call { display: inline-flex; }
    .demo-nav__icon { display: none; }
  }
  @media (min-width: 84rem) {
    .demo-nav__open { display: inline-flex; }
  }

  /* ---------------------------------------------------------------- menu */
  .demo-menu {
    width: min(100vw - 1.5rem, 30rem);
    max-height: calc(100dvh - 1.5rem);
    margin: 0.75rem 0.75rem auto auto;
    padding: var(--sp-5);
    color: var(--ink);
    overflow: auto;
  }
  /* The menu is the one place the glass holds a lot of small text over a
     moving page, so it gets a firmer fill. */
  .demo-menu--smoke { background: rgba(0, 24, 64, 0.94); }
  .demo-menu--frost { background: rgba(0, 24, 64, 0.94); }
  .demo-menu--clear { background: rgba(10, 26, 18, 0.95); }
  .demo-menu::backdrop { background: rgba(0, 12, 34, 0.55); }
  .demo-menu[open] { display: grid; gap: var(--sp-5); }
  .demo-menu__head { display: flex; align-items: center; justify-content: space-between; }
  .demo-menu__x { position: relative; width: 18px; height: 18px; }
  .demo-menu__x::before,
  .demo-menu__x::after {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    rotate: 45deg;
  }
  .demo-menu__x::after { rotate: -45deg; }
  .demo-menu__links { list-style: none; margin: 0; padding: 0; }
  .demo-menu__links li { border-bottom: 1px solid var(--hair); }
  .demo-menu__links a {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    font-size: 0.9375rem;
  }
  .demo-menu__foot { display: grid; gap: var(--sp-4); justify-items: start; }
</style>

<script>
  function wireNav() {
    for (const nav of document.querySelectorAll<HTMLElement>('[data-demo-nav]')) {
      if (nav.dataset.wired) continue;
      nav.dataset.wired = '';

      // Shrink slightly once the page has moved.
      const onScroll = () => nav.toggleAttribute('data-scrolled', window.scrollY > 24);
      onScroll();
      addEventListener('scroll', onScroll, { passive: true });

      // One orange per viewport: go quiet while an in-page primary is visible.
      const primaries = document.querySelectorAll('[data-primary]');
      if (primaries.length && 'IntersectionObserver' in window) {
        const visible = new Set<Element>();
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
          nav.toggleAttribute('data-quiet', visible.size > 0);
        });
        primaries.forEach((p) => io.observe(p));
        document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
      }

      // Menu: a real <dialog>, so focus, Escape and the backdrop come free.
      const dialog = nav.querySelector<HTMLDialogElement>('[data-menu]');
      const open = nav.querySelector<HTMLButtonElement>('[data-menu-open]');
      const close = nav.querySelector<HTMLButtonElement>('[data-menu-close]');
      if (!dialog || !open) continue;
      open.addEventListener('click', () => {
        dialog.showModal();
        open.setAttribute('aria-expanded', 'true');
      });
      close?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('close', () => {
        open.setAttribute('aria-expanded', 'false');
        open.focus();
      });
      // A tap on the dim backdrop closes it.
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
      dialog.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dialog.close()));
    }
  }
  wireNav();
  document.addEventListener('astro:page-load', wireNav);
</script>
