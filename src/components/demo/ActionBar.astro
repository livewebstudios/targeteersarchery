---
/**
 * Below 48rem: a fixed glass bar at the bottom of the screen with the three
 * things a phone visitor wants. CALL is the orange one; the other two are
 * quiet. The single biggest UX fix for Rob's customers, in all three demos.
 */
import { business } from '~/data/business';
import PhoneIcon from '~/components/icons/PhoneIcon.astro';
import PinRingIcon from '~/components/icons/PinRingIcon.astro';
import ClockRingIcon from '~/components/icons/ClockRingIcon.astro';

interface Props {
  glass: 'smoke' | 'frost' | 'clear';
  /** Where HOURS scrolls to. */
  hoursHref?: string;
}
const { glass, hoursHref = '#visit' } = Astro.props;
---
<nav class={`action-bar action-bar--${glass} glass-${glass}`} aria-label="Call, directions and hours">
  <a class="action-bar__call" href={business.phoneHref}>
    <PhoneIcon size={20} />
    <span>CALL</span>
  </a>
  <a href={business.directionsUrl} target="_blank" rel="noopener">
    <PinRingIcon size={20} />
    <span>DIRECTIONS</span>
  </a>
  <a href={hoursHref}>
    <ClockRingIcon size={20} />
    <span>HOURS</span>
  </a>
</nav>

<style>
  .action-bar {
    display: none;
  }
  @media (max-width: 47.99rem) {
    .action-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 95;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.4rem;
      padding: 0.45rem 0.6rem calc(0.45rem + env(safe-area-inset-bottom, 0px));
      border-radius: 18px 18px 0 0;
      border-bottom: 0;
    }
    /* Stronger fill than a card: text sits over whatever scrolls behind it. */
    .action-bar--smoke { background: rgba(0, 24, 64, 0.86); }
    .action-bar--frost { background: rgba(248, 248, 244, 0.92); }
    .action-bar--clear { background: rgba(10, 26, 18, 0.86); border-radius: 6px 6px 0 0; }
  }
  a {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.2rem;
    min-height: 3.25rem;
    border-radius: 12px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid var(--hair);
  }
  .action-bar--clear a { border-radius: 4px; }
  .action-bar__call {
    background: var(--tgt-orange);
    color: var(--tgt-navy);
    border-color: transparent;
  }
  .action-bar__call:active { background: var(--tgt-orange-hi); }
  @media print { .action-bar { display: none; } }
</style>
