---
/**
 * The demo footer, one glass panel in whichever skin the demo uses. Four
 * columns: the brand, SHOOT WITH US, THE SHOP, VISIT. Then the base bar with
 * the copyright, the LWS badge and the credit.
 */
import { Image } from 'astro:assets';
import logoRGB from '~/assets/brand/logoRGB.png';
import { business } from '~/data/business';
import { footerNav } from '~/data/nav';
import SocialIcon from '~/components/icons/SocialIcon.astro';

interface Props {
  variant: 'smoke' | 'frost' | 'clear';
  /** Use a compact two-row layout (Trailhead). */
  compact?: boolean;
}
const { variant, compact = false } = Astro.props;
const year = new Date().getFullYear();
const shoot = footerNav.find((c) => c.heading === 'Shoot With Us')!;
const shop = footerNav.find((c) => c.heading === 'The Shop')!;
const family = footerNav.find((c) => c.heading === 'The Family')!;

/* Hand-written public paths stay relative (LWS path rule), so count how deep
   this route sits. /demos/1-base-camp/ is two levels down. */
const depth = Astro.url.pathname.split('/').filter(Boolean).length;
const rel = depth ? '../'.repeat(depth) : './';
---
<footer class={`demo-footer demo-footer--${variant} ${compact ? 'is-compact' : ''}`}>
  <div class="d-wrap">
    <div class={`demo-footer__panel glass-${variant}`}>
      <div class="demo-footer__cols">
        <div class="demo-footer__brand">
          <a class="demo-footer__logo" href="/">
            <Image src={logoRGB} alt="Targeteers Archery" widths={[320, 640]} sizes="180px" loading="lazy" />
          </a>
          <p class="demo-footer__tag">{business.tagline}</p>
          <p class="demo-footer__blurb">Family owned on Route 46 since {business.founded}.</p>
          <ul class="demo-footer__social">
            <li><a href={business.socials.facebook} target="_blank" rel="noopener" aria-label="Targeteers Archery on Facebook"><SocialIcon network="facebook" /></a></li>
            <li><a href={business.socials.instagram} target="_blank" rel="noopener" aria-label="Targeteers Archery on Instagram"><SocialIcon network="instagram" /></a></li>
            <li><a href={business.socials.twitter} target="_blank" rel="noopener" aria-label="Targeteers Archery on X"><SocialIcon network="twitter" /></a></li>
          </ul>
        </div>

        <nav class="demo-footer__col" aria-label="Shoot with us">
          <h2 class="demo-footer__heading">SHOOT WITH US</h2>
          <ul>{shoot.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>

        <nav class="demo-footer__col" aria-label="The shop">
          <h2 class="demo-footer__heading">THE SHOP</h2>
          <ul>
            {shop.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            {family.links.slice(0, 2).map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>

        <div class="demo-footer__col">
          <h2 class="demo-footer__heading">VISIT</h2>
          <address>
            <a href={business.mapsUrl} target="_blank" rel="noopener">{business.address.street}<br />{business.address.city}, {business.address.region} {business.address.postal}</a>
            <a class="demo-footer__phone" href={business.phoneHref}>{business.phone}</a>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </address>
        </div>
      </div>

      <div class="demo-footer__base">
        <p>&copy; {year} {business.name}. All rights reserved.</p>
        <a class="demo-footer__lws" href="https://livewebstudios.com" target="_blank" rel="noopener">
          <img src={`${rel}images/verifiedsecured.png`} alt="Verified and Secured by Live Web Studios" width="150" height="37" loading="lazy" decoding="async" />
          <span>Built by Live Web Studios</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .demo-footer { padding-block: var(--sp-8) var(--sp-6); }
  .demo-footer__panel { padding: clamp(1.5rem, 0.8rem + 3vw, 3rem); }

  .demo-footer__cols {
    display: grid;
    gap: var(--sp-7) var(--sp-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }
  @media (min-width: 64rem) {
    .demo-footer__cols { grid-template-columns: 1.4fr 1fr 1fr 1.2fr; }
  }

  .demo-footer__logo {
    display: inline-block;
    background: #fff;
    border-radius: 12px;
    padding: 0.6rem 1rem;
    line-height: 0;
  }
  .demo-footer--clear .demo-footer__logo { border-radius: 4px; }
  .demo-footer__logo :global(img) { width: 11rem; height: auto; }
  .demo-footer__tag {
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ink);
  }
  .demo-footer--clear .demo-footer__tag {
    font-family: var(--font-condensed, var(--font-display));
    font-style: italic;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .demo-footer__blurb { margin-top: var(--sp-2); font-size: var(--fs-small); color: var(--ink-muted); }

  .demo-footer__social { display: flex; gap: var(--sp-2); list-style: none; margin: var(--sp-4) 0 0; padding: 0; }
  .demo-footer__social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--hair-strong);
    color: var(--ink);
  }
  .demo-footer--clear .demo-footer__social a { border-radius: 4px; }

  .demo-footer__heading {
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: var(--ls-eyebrow);
    color: var(--accent-text);
    margin-bottom: var(--sp-3);
  }
  .demo-footer__col ul { list-style: none; margin: 0; padding: 0; }
  .demo-footer__col li a,
  .demo-footer__col address a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    font-size: var(--fs-small);
    color: var(--ink-muted);
    text-decoration: none;
  }
  .demo-footer__col li a {
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .demo-footer__col a:hover { color: var(--ink); text-decoration: underline; }
  address { display: grid; gap: var(--sp-2); font-style: normal; justify-items: start; }
  .demo-footer__col address a { line-height: 1.5; }
  .demo-footer__col .demo-footer__phone {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .demo-footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--hair);
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }
  .demo-footer__base p { margin: 0; }
  .demo-footer__lws {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
    color: var(--ink-muted);
    text-decoration: none;
  }
  .demo-footer__lws:hover { color: var(--ink); }
  /* The badge renders at its intrinsic 150px width, height auto. */
  .demo-footer__lws img { width: 150px; height: auto; flex: none; }

  .is-compact .demo-footer__panel { padding: clamp(1.25rem, 0.8rem + 2vw, 2rem); }
  .is-compact .demo-footer__cols { gap: var(--sp-6); }
</style>
