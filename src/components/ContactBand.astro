---
import { business, addressLine } from '~/data/business';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
import TargetIcon from './icons/TargetIcon.astro';
import OpenNowPill from './OpenNowPill.astro';

interface Props {
  title?: string;
  body?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  tone?: 'pine' | 'linen';
}
const {
  title = 'Come see us.',
  body = 'The best way to find the right bow is to stand behind one. Call ahead, or just walk in. We are on Route 46 in Saddle Brook.',
  primary = { label: 'Book a lesson', href: '/lessons/#book' },
  secondary = { label: 'Get directions', href: business.directionsUrl },
  tone = 'pine',
} = Astro.props;
---
<section class={`contact-band tone-${tone}`} aria-labelledby="contact-band-title">
  <div class="contact-band__rings" aria-hidden="true"><TargetIcon size={560} strokeWidth={0.4} /></div>
  <div class="wrap contact-band__inner">
    <div class="contact-band__copy" data-reveal>
      <Eyebrow>Talk to a pro</Eyebrow>
      <h2 id="contact-band-title">{title}</h2>
      <p>{body}</p>
      <div class="contact-band__actions">
        <Button href={primary.href} variant="primary">{primary.label}</Button>
        <Button href={secondary.href} variant="ghost" external={secondary.href.startsWith('http')}>
          {secondary.label}
        </Button>
      </div>
    </div>

    <dl class="contact-band__details" data-reveal>
      <div>
        <dt>Call</dt>
        <dd><a href={business.phoneHref}>{business.phone}</a></dd>
      </div>
      <div>
        <dt>Visit</dt>
        <dd><a href={business.mapsUrl} target="_blank" rel="noopener">{addressLine}</a></dd>
      </div>
      <div>
        <dt>Email</dt>
        <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
      </div>
      <div>
        <dt>Today</dt>
        <dd><OpenNowPill compact /></dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .contact-band {
    position: relative;
    background: var(--bg);
    color: var(--fg);
    padding-block: var(--section-y);
    overflow: hidden;
    isolation: isolate;
  }
  .contact-band__rings {
    position: absolute;
    top: 50%; right: -10rem;
    translate: 0 -50%;
    color: var(--accent);
    opacity: 0.07;
    pointer-events: none;
  }
  .contact-band__rings :global(svg) { width: 35rem; height: 35rem; }

  .contact-band__inner {
    position: relative;
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .contact-band__inner { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--sp-9); }
  }
  .contact-band__copy p { max-width: 44ch; margin-top: var(--sp-4); font-size: var(--fs-lead); line-height: 1.5; }
  .contact-band__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-6); }

  .contact-band__details {
    display: grid;
    gap: var(--sp-5);
    margin: 0;
    padding-top: var(--sp-2);
  }
  @media (min-width: 30rem) {
    .contact-band__details { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .contact-band__details dt {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .contact-band__details dd { margin: 0; font-size: var(--fs-small); line-height: 1.55; }
  .contact-band__details a { color: var(--fg); text-decoration: none; transition: color var(--dur-fast) var(--ease); }
  .contact-band__details a:hover { color: var(--accent); }
</style>
