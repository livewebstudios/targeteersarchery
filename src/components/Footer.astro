---
/**
 * The site footer: one clear-glass panel. The brand, every page on the site
 * grouped under the five destinations, and the visit block (address, phone,
 * email, the week's hours with today in bold). The mobile action bar's HOURS
 * button lands on #hours. Then the base bar: copyright, the LWS badge at its
 * intrinsic 150px, and the credit.
 */
import { Image } from 'astro:assets';
import logoRGB from '~/assets/brand/logoRGB.png';
import { business } from '~/data/business';
import { footerNav } from '~/data/nav';
import SocialIcon from './icons/SocialIcon.astro';
import HoursTable from './HoursTable.astro';
import PinRingIcon from './icons/PinRingIcon.astro';

const year = new Date().getFullYear();

/* Hand-written public paths stay relative (LWS path rule), so count how deep
   this route sits. /insights/category/hunting/ is three levels down. */
const depth = Astro.url.pathname.split('/').filter(Boolean).length;
const rel = depth ? '../'.repeat(depth) : './';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__panel glass">
      <div class="site-footer__cols">
        <div class="site-footer__brand">
          <a class="site-footer__logo" href="/" aria-label={`${business.shortName}, home`}>
            <Image src={logoRGB} alt="Targeteers Archery" widths={[320, 640]} sizes="180px" loading="lazy" />
          </a>
          <p class="site-footer__tag">{business.tagline}</p>
          <p class="site-footer__blurb">
            Family owned on Route 46 since {business.founded}. A full pro shop, an eleven-lane indoor
            range, and people who tune your bow like it is their own.
          </p>
          <ul class="site-footer__social">
            <li><a href={business.socials.facebook} target="_blank" rel="noopener" aria-label="Targeteers Archery on Facebook"><SocialIcon network="facebook" /></a></li>
            <li><a href={business.socials.instagram} target="_blank" rel="noopener" aria-label="Targeteers Archery on Instagram"><SocialIcon network="instagram" /></a></li>
            <li><a href={business.socials.twitter} target="_blank" rel="noopener" aria-label="Targeteers Archery on X"><SocialIcon network="twitter" /></a></li>
          </ul>
        </div>

        <nav class="site-footer__nav" aria-label="Every page">
          {footerNav.map((col) => (
            <div class="site-footer__col">
              <h2 class="site-footer__heading">{col.heading}</h2>
              <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
            </div>
          ))}
        </nav>

        <div class="site-footer__visit" id="hours">
          <h2 class="site-footer__heading">Visit</h2>
          <address>
            <a href={business.mapsUrl} target="_blank" rel="noopener">{business.address.street}<br />{business.address.city}, {business.address.region} {business.address.postal}</a>
            <a class="site-footer__phone" href={business.phoneHref}>{business.phone}</a>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </address>
          <HoursTable class="site-footer__hours" />
          <a class="d-link" href={business.directionsUrl} target="_blank" rel="noopener">
            <PinRingIcon size={16} /><span>GET DIRECTIONS</span>
          </a>
        </div>
      </div>

      <div class="site-footer__base">
        <p>&copy; {year} {business.name}. All rights reserved.</p>
        <a class="site-footer__lws" href="https://livewebstudios.com" target="_blank" rel="noopener">
          <img src={`${rel}images/verifiedsecured.png`} alt="Verified and Secured by Live Web Studios" width="150" height="37" loading="lazy" decoding="async" />
          <span>Built by Live Web Studios</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--sp-8) var(--sp-6); }
  .site-footer__panel { padding: var(--panel-pad); }

  .site-footer__cols {
    display: grid;
    gap: var(--sp-7) var(--sp-6);
  }
  .site-footer__nav {
    display: grid;
    gap: var(--sp-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
  }
  @media (min-width: 48rem) {
    .site-footer__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-footer__nav { grid-column: 1 / -1; grid-row: 2; }
  }
  @media (min-width: 72rem) {
    .site-footer__cols { grid-template-columns: 1.15fr 2.6fr 1.25fr; }
    .site-footer__nav { grid-column: auto; grid-row: auto; }
  }

  .site-footer__logo {
    display: inline-block;
    background: #fff;
    border-radius: 12px;
    padding: 0.6rem 1rem;
    line-height: 0;
  }
  .site-footer__logo :global(img) { width: 11rem; height: auto; }
  .site-footer__tag {
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ink);
  }
  .site-footer__blurb { margin-top: var(--sp-2); font-size: var(--fs-small); color: var(--ink-muted); max-width: 34ch; }

  .site-footer__social { display: flex; gap: var(--sp-2); list-style: none; margin: var(--sp-4) 0 0; padding: 0; }
  .site-footer__social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--hair-strong);
    color: var(--ink);
  }
  .site-footer__social a:hover { border-color: var(--ink); }

  .site-footer__heading {
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--sp-3);
  }
  .site-footer__col ul { list-style: none; margin: 0; padding: 0; }
  .site-footer__col a,
  .site-footer__visit address a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    font-size: var(--fs-small);
    color: var(--ink-muted);
    text-decoration: none;
  }
  .site-footer__col a {
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .site-footer__col a:hover,
  .site-footer__visit address a:hover { color: var(--ink); text-decoration: underline; }

  .site-footer__visit { display: grid; gap: var(--sp-4); align-content: start; justify-items: start; scroll-margin-top: 7.5rem; }
  .site-footer__visit .site-footer__heading { margin-bottom: 0; }
  address { display: grid; gap: var(--sp-1); font-style: normal; justify-items: start; }
  .site-footer__visit address a { line-height: 1.5; }
  .site-footer__visit .site-footer__phone {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .site-footer__visit :global(.site-footer__hours) { max-width: 22rem; }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--hair);
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }
  .site-footer__base p { margin: 0; }
  .site-footer__lws {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-4);
    color: var(--ink-muted);
    text-decoration: none;
  }
  .site-footer__lws:hover { color: var(--ink); }
  /* The badge renders at its intrinsic 150px width, height auto. */
  .site-footer__lws img { width: 150px; height: auto; flex: none; }
</style>
