---
/**
 * Buttons in the glass skin. Orange is rationed: one per screen, and the nav's
 * CALL button already holds it, so a page's main action is a white fill with
 * navy text (`primary`). `orange` is for a page's one real call to action;
 * it marks itself data-primary so the nav's CALL steps down to an outline
 * while it is on screen, and the phone action bar takes over below 48rem.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'orange' | 'ghost' | 'dark' | 'quiet';
  type?: 'button' | 'submit';
  class?: string;
  external?: boolean;
  'aria-label'?: string;
}
const {
  href,
  variant = 'primary',
  type = 'button',
  class: klass = '',
  external = false,
  ...rest
} = Astro.props;
const Tag = href ? 'a' : 'button';
const SKIN: Record<NonNullable<Props['variant']>, string> = {
  primary: 'd-btn d-btn--light',
  orange: 'd-btn d-btn--orange',
  ghost: 'd-btn d-btn--outline',
  dark: 'd-btn d-btn--navy',
  quiet: 'd-link',
};
---
<Tag
  class={`btn ${SKIN[variant]} ${klass}`}
  href={href}
  type={href ? undefined : type}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  data-primary={variant === 'orange' ? '' : undefined}
  {...rest}
>
  <span><slot /></span>
</Tag>
