---
import type { NavGroup, NavLink } from '~/data/nav';
import { subNavLinks, activeHref } from '~/data/nav';

interface Props {
  groups: NavGroup[];
  contact: NavLink;
  cta: NavLink;
  phone: string;
  phoneHref: string;
  current: string;
}
const { groups, contact, cta, phone, phoneHref, current } = Astro.props;
const activeInGroup = new Map(
  groups.map((g) => [g.id, activeHref([...subNavLinks(g), { label: g.label, href: g.href }], current)]),
);
const contactActive = current.startsWith(contact.href);
/** Stagger index runs continuously through every group so the reveal reads as one sweep. */
let step = 0;
---
<!--
  Full-screen cream overlay menu. Deliberately not a React island: it is on
  every page, and a hamburger does not justify shipping a UI framework to
  someone on a phone in a parking lot. Focus is trapped while open, Escape
  closes it, and the page underneath is locked.

  Every group is expanded. No accordions: a parent looking for kids camp on a
  phone should see it without tapping a disclosure first.
-->
<button
  type="button"
  class="menu-toggle"
  aria-expanded="false"
  aria-controls="mobile-menu"
  data-menu-toggle
>
  <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
  <span class="visually-hidden" data-menu-label>Open menu</span>
</button>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true" data-menu-panel inert>
  <div class="mobile-menu__ring" aria-hidden="true">
    <svg viewBox="0 0 400 400" fill="none" stroke="currentColor">
      {[190, 148, 106, 64].map((r, i) => (
        <circle cx="200" cy="200" r={r} stroke-width="1.25" pathLength="1" style={`--i:${i}`} />
      ))}
      <circle cx="200" cy="200" r="22" fill="currentColor" stroke="none" style="--i:4" />
    </svg>
  </div>

  <div class="mobile-menu__inner">
    <nav aria-label="Main menu">
      {groups.map((group) => (
        <section class="m-group" style={`--i:${step++}`}>
          <a class="m-group__title" href={group.href} aria-current={activeInGroup.get(group.id) === group.href ? 'page' : undefined}>
            {group.label}
          </a>
          <ul class="m-group__links">
            {group.columns.flatMap((column) => column.links).map((link) => (
              <li>
                <a href={link.href} aria-current={activeInGroup.get(group.id) === link.href ? 'page' : undefined}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <section class="m-group" style={`--i:${step++}`}>
        <a class="m-group__title" href={contact.href} aria-current={contactActive ? 'page' : undefined}>
          {contact.label}
        </a>
      </section>
    </nav>
    <div class="mobile-menu__foot" style={`--i:${step++}`}>
      <a class="mobile-menu__cta" href={cta.href}>{cta.label}</a>
      <a class="mobile-menu__phone" href={phoneHref}>{phone}</a>
    </div>
  </div>
</div>

<script>
  const FOCUSABLE = 'a[href], button:not([disabled])';

  function wire() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
    const label = toggle?.querySelector('[data-menu-label]');
    const bars = toggle?.querySelector<HTMLElement>('.menu-toggle__bars');
    if (!toggle || !panel) return;

    const header = toggle.closest<HTMLElement>('.site-nav');
    let open = false;
    let restoreOverflow = '';

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') { setOpen(false); toggle.focus(); return; }
      if (e.key !== 'Tab') return;
      const items = panel.querySelectorAll<HTMLElement>(FOCUSABLE);
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    };

    function setOpen(next: boolean) {
      if (next === open) return;
      open = next;
      toggle!.setAttribute('aria-expanded', String(open));
      panel!.setAttribute('aria-hidden', String(!open));
      panel!.toggleAttribute('data-open', open);
      panel!.toggleAttribute('inert', !open);
      bars?.toggleAttribute('data-open', open);
      // Lift the header above the overlay so the toggle stays reachable and
      // visibly becomes the close button.
      header?.toggleAttribute('data-menu-open', open);
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';

      if (open) {
        restoreOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        document.addEventListener('keydown', onKey);
        window.setTimeout(() => panel!.querySelector<HTMLElement>('a[href]')?.focus(), 320);
      } else {
        document.body.style.overflow = restoreOverflow;
        document.removeEventListener('keydown', onKey);
      }
    }

    toggle.addEventListener('click', () => setOpen(!open));
    // A navigation inside the overlay should leave the body scrollable again.
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a[href]')) setOpen(false);
    });
    document.addEventListener('astro:before-swap', () => setOpen(false), { once: true });
  }

  wire();
  document.addEventListener('astro:after-swap', wire);
</script>
