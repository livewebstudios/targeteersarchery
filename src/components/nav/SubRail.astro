---
import type { NavGroup } from '~/data/nav';
import { subNavLinks, activeHref } from '~/data/nav';
import ArrowIcon from '../icons/ArrowIcon.astro';

interface Props {
  group: NavGroup;
  current: string;
}
const { group, current } = Astro.props;
const links = subNavLinks(group);
const active = activeHref(links, current);
const isHere = (href: string) => href === active;
---
<!--
  The vertical half of the sub-nav: a fixed rail in the right margin, shown
  from 104rem up, the width at which the gutter clears the content column. It fades in once
  the page hero is behind you, so it never sits on the photograph.

  It lives in the layout rather than inside the header because the header
  carries a backdrop-filter, which would make it the containing block for a
  fixed child and pin the rail to the header instead of the viewport.
-->
<nav class="subrail" aria-label={`${group.label} pages`} data-subrail>
  <p class="subrail__heading">{group.label}</p>
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href} aria-current={isHere(link.href) ? 'page' : undefined}>
          <span class="subrail__tick" aria-hidden="true"></span>
          <span>{link.label}</span>
        </a>
      </li>
    ))}
  </ul>
  <a class="subrail__cta" href="/contact/">
    <span>Ask a pro</span> <ArrowIcon size={13} />
  </a>
</nav>

<style>
  .subrail {
    display: none;
    position: fixed;
    top: 50%;
    right: var(--gutter);
    translate: 0 -50%;
    z-index: calc(var(--z-nav) - 1);
    width: 11.5rem;
    max-height: 78vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--sp-4) var(--sp-4) var(--sp-3);
    background: var(--cream-50);
    border: 1px solid var(--cream-200);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    color: var(--bark-900);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease);
  }
  @media (min-width: 104rem) { .subrail { display: block; } }
  .subrail[data-visible] { opacity: 1; pointer-events: auto; }

  .subrail__heading {
    margin: 0 0 var(--sp-3);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--cream-200);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--stone-400);
  }
  .subrail ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.1rem; }
  .subrail li a {
    display: grid;
    grid-template-columns: 0.5rem minmax(0, 1fr);
    align-items: start;
    gap: 0.5rem;
    padding: 0.42rem 0;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bark-500);
    transition: color var(--dur-fast) var(--ease);
  }
  .subrail li a:hover { color: var(--ember); }
  .subrail__tick {
    width: 0.5rem;
    height: 1px;
    margin-top: 0.55em;
    background: var(--parchment);
    transition: background var(--dur-fast) var(--ease);
  }
  .subrail li a:hover .subrail__tick { background: var(--ember); }
  .subrail li a[aria-current='page'] { color: var(--bark-900); }
  .subrail li a[aria-current='page'] .subrail__tick { background: var(--ember); height: 2px; }

  .subrail__cta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--cream-200);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ember);
    white-space: nowrap;
  }
  .subrail__cta :global(svg) { flex: none; transition: translate var(--dur-fast) var(--ease); }
  .subrail__cta:hover :global(svg) { translate: 3px 0; }

  @media (prefers-reduced-motion: reduce) {
    .subrail { transition-duration: 1ms; }
  }
</style>

<script>
  function wireSubRail() {
    const rail = document.querySelector<HTMLElement>('[data-subrail]');
    if (!rail) return;
    let ticking = false;
    const apply = () => {
      ticking = false;
      // Show it once the page hero is behind you, so it never lands on the
      // photograph.
      rail.toggleAttribute('data-visible', window.scrollY > window.innerHeight * 0.5);
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    };
    addEventListener('scroll', onScroll, { passive: true });
    apply();
  }
  wireSubRail();
  document.addEventListener('astro:after-swap', wireSubRail);
</script>
