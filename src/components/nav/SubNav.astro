---
import type { NavGroup } from '~/data/nav';
import { subNavLinks, activeHref } from '~/data/nav';

interface Props {
  group: NavGroup;
  current: string;
}
const { group, current } = Astro.props;
const links = subNavLinks(group);
const active = activeHref([...links, { label: group.label, href: group.href }], current);
const isHere = (href: string) => href === active;
---
<!--
  The rest of the group, one row, inside the sticky header so it never scrolls
  away. Above 104rem this gives way to SubRail, the fixed vertical version in
  the right margin.
-->
<div class="subbar" data-subbar>
  <div class="wrap-wide subbar__inner">
    <a class="subbar__group" href={group.href} aria-current={isHere(group.href) ? 'page' : undefined}>
      {group.label}
    </a>
    <nav class="subbar__scroll" aria-label={`${group.label} pages`}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isHere(link.href) ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</div>

<style>
  /* ------------------------------------------------------------ the strip */
  .subbar {
    display: block;
    background: var(--cream-100);
    border-top: 1px solid var(--cream-200);
    border-bottom: 1px solid var(--cream-200);
    color: var(--bark-900);
  }
  @media (min-width: 104rem) { .subbar { display: none; } }

  .subbar__inner {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    min-height: 3rem;
  }
  .subbar__group {
    flex: none;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bark-900);
    padding-right: var(--sp-4);
    border-right: 1px solid var(--cream-200);
    white-space: nowrap;
  }
  .subbar__group:hover { color: var(--ember); }
  @media (max-width: 40rem) { .subbar__group { display: none; } }

  .subbar__scroll {
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    /* The strip runs past the gutter on a phone, so fade the cut edge rather
       than chopping a word in half. */
    mask-image: linear-gradient(to right, transparent 0, #000 1rem, #000 calc(100% - 2rem), transparent 100%);
  }
  .subbar__scroll::-webkit-scrollbar { display: none; }
  .subbar__scroll ul {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0 2rem 0 1rem;
  }
  .subbar__scroll a {
    display: block;
    white-space: nowrap;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bark-500);
    padding: 0.62rem 0.7rem;
    border-radius: var(--radius);
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .subbar__scroll a:hover { color: var(--ember); background: var(--cream-200); }
  .subbar__scroll a[aria-current='page'] {
    color: var(--bark-900);
    background: var(--cream-50);
    box-shadow: inset 0 0 0 1px var(--cream-200);
  }

  /* The strip belongs to the header, so an open overlay menu hides it. */
  :global(.site-nav[data-menu-open]) .subbar { display: none; }
</style>

<script>
  /* Bring the current page's chip into view, so the strip does not open
     halfway through a group with no sign of where you are. */
  function centreCurrentChip() {
    const scroller = document.querySelector<HTMLElement>('.subbar__scroll');
    const here = scroller?.querySelector<HTMLElement>('a[aria-current="page"]');
    if (!scroller || !here) return;
    const target = here.offsetLeft - (scroller.clientWidth - here.offsetWidth) / 2;
    scroller.scrollLeft = Math.max(0, target);
  }
  centreCurrentChip();
  document.addEventListener('astro:after-swap', centreCurrentChip);
</script>
