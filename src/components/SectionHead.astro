---
import Eyebrow from './Eyebrow.astro';
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
  level?: 2 | 3;
  class?: string;
  /** Off for the rare heading that should not be shot at. */
  arrow?: boolean;
}
const {
  eyebrow, title, lead, align = 'start', level = 2, class: klass = '', arrow = true,
} = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---
<!--
  The arrow is the shared .shot-head rule in global.css, not markup of its own,
  so a section heading written by hand elsewhere gets the same treatment from
  the same class.
-->
<header class={`section-head align-${align} ${klass}`} data-reveal>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <Heading class={arrow ? 'shot-head' : undefined}>{title}</Heading>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>

<style>
  .section-head { max-width: 46rem; margin-bottom: var(--sp-7); }
  .section-head .lead { margin-top: var(--sp-4); }
  .align-center { margin-inline: auto; text-align: center; }
  .align-center :global(.eyebrow) { justify-content: center; }
  .align-center .lead { margin-inline: auto; }
</style>
