---
/**
 * One section of a page: a single clear-glass panel over the landscape.
 * Everything inside it is a pane (tinted, never blurred again), so there is
 * never glass inside glass.
 *
 * `tone` is kept for the pages that still pass it. There is one skin now, so
 * every tone renders the same panel; `pine` and `bark` read a touch deeper,
 * which keeps a run of panels from looking identical.
 */
interface Props {
  tone?: 'cream' | 'linen' | 'pine' | 'bark';
  id?: string;
  class?: string;
  width?: 'default' | 'narrow' | 'wide' | 'full';
  /** Extra air inside the panel for the set-piece sections. */
  size?: 'default' | 'tight' | 'tall';
  as?: 'section' | 'div' | 'article' | 'aside';
  /** Retired with the cream skin. Accepted and ignored. */
  aura?: boolean;
  /** Content sits straight on the page with no panel (rare). */
  bare?: boolean;
  'aria-labelledby'?: string;
  'aria-label'?: string;
}
const {
  tone = 'cream',
  id,
  class: klass = '',
  width = 'default',
  size = 'default',
  as: Tag = 'section',
  bare = false,
  ...rest
} = Astro.props;

const WRAPPERS: Record<NonNullable<Props['width']>, string> = {
  default: 'wrap',
  narrow: 'wrap-narrow',
  wide: 'wrap-wide',
  full: 'wrap-wide',
};
const deep = tone === 'pine' || tone === 'bark';
---
<Tag id={id} class={`section size-${size} ${klass}`} {...rest}>
  <div class={WRAPPERS[width]}>
    <div class={`section__inner ${bare ? '' : 'glass section__panel'} ${deep ? 'is-deep' : ''}`}>
      <slot />
    </div>
  </div>
</Tag>

<style>
  .section {
    position: relative;
    color: var(--ink);
    scroll-margin-top: 7rem;
  }
  .section__panel { padding: var(--panel-pad); }
  .size-tight .section__panel { padding-block: calc(var(--panel-pad) * 0.75); }
  .size-tall .section__panel { padding-block: calc(var(--panel-pad) * 1.35); }
  /* A deeper tint for rhythm. Still clear glass, still one blur. */
  .section__panel.is-deep {
    background:
      linear-gradient(140deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.03) 50%, rgba(255, 255, 255, 0.08) 100%),
      rgba(0, 24, 64, 0.34);
  }
  @media (prefers-reduced-transparency: reduce) {
    .section__panel.is-deep { background: var(--glass-solid); }
  }
  .section :global(p) { color: var(--ink-muted); }
  .section :global(:is(h1, h2, h3, h4)) { color: var(--ink); }
</style>
