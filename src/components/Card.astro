---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowRightIcon from './icons/ArrowRightIcon.astro';

interface Props {
  href: string;
  title: string;
  body?: string;
  eyebrow?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  ratio?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}
const {
  href, title, body, eyebrow, image, imageAlt = '', ratio = '4 / 3',
  class: klass = '', loading = 'lazy',
} = Astro.props;
---
<a class={`card ${klass}`} href={href} style={`--ratio:${ratio}`}>
  {image && (
    <div class="card__media">
      <Image src={image} alt={imageAlt} widths={[420, 760, 1100]}
        sizes="(max-width: 48rem) 92vw, (max-width: 72rem) 44vw, 24rem" loading={loading} />
    </div>
  )}
  <div class="card__body">
    {eyebrow && <p class="card__eyebrow">{eyebrow}</p>}
    <h3 class="card__title">{title}</h3>
    {body && <p class="card__text">{body}</p>}
    <span class="card__go" aria-hidden="true"><ArrowRightIcon size={17} /></span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--bg, var(--cream-50));
    border: 1px solid var(--rule, var(--cream-200));
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: translate var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
    height: 100%;
  }
  .card:hover { translate: 0 -4px; box-shadow: var(--shadow); border-color: var(--parchment); }

  .card__media { aspect-ratio: var(--ratio); overflow: hidden; background: var(--cream-100); }
  .card__media :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: scale var(--dur-slow) var(--ease);
  }
  .card:hover .card__media :global(img) { scale: 1.03; }

  .card__body {
    padding: var(--sp-5) var(--sp-5) var(--sp-6);
    display: grid;
    gap: var(--sp-3);
    align-content: start;
    flex: 1;
  }
  .card__eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent, var(--ember));
    margin: 0;
  }
  .card__title { font-size: var(--fs-h4); margin: 0; }
  .card__text { font-size: var(--fs-small); line-height: 1.6; color: var(--fg-muted, var(--bark-500)); margin: 0; }
  .card__go { color: var(--accent, var(--ember)); margin-top: auto; padding-top: var(--sp-2); transition: translate var(--dur) var(--ease); }
  .card:hover .card__go { translate: 0.35rem 0; }
</style>
