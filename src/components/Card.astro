---
/**
 * A link card. It always sits inside a glass section, so it is a pane:
 * tinted and rimmed, never blurred. Rob's photo lives inside it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowRightIcon from './icons/ArrowRightIcon.astro';

interface Props {
  href: string;
  title: string;
  body?: string;
  eyebrow?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  ratio?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}
const {
  href, title, body, eyebrow, image, imageAlt = '', ratio = '4 / 3',
  class: klass = '', loading = 'lazy',
} = Astro.props;
---
<a class={`card pane ${klass}`} href={href} style={`--ratio:${ratio}`}>
  {image && (
    <div class="card__media">
      <Image src={image} alt={imageAlt} widths={[420, 760, 1100]}
        sizes="(max-width: 48rem) 92vw, (max-width: 72rem) 44vw, 24rem" loading={loading} />
    </div>
  )}
  <div class="card__body">
    {eyebrow && <p class="card__eyebrow">{eyebrow}</p>}
    <h3 class="card__title">{title}</h3>
    {body && <p class="card__text">{body}</p>}
    <span class="card__go" aria-hidden="true"><ArrowRightIcon size={17} /></span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--ink);
    overflow: hidden;
    height: 100%;
    transition: transform var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .card:hover { transform: translateY(-3px); background: var(--pane-fill-hover); border-color: rgba(255, 255, 255, 0.4); }

  .card__media { aspect-ratio: var(--ratio); overflow: hidden; margin: 0.5rem 0.5rem 0; border-radius: 12px; }
  .card__media :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: scale var(--dur-slow) var(--ease);
  }
  .card:hover .card__media :global(img) { scale: 1.03; }

  .card__body {
    padding: var(--sp-5);
    display: grid;
    gap: var(--sp-3);
    align-content: start;
    flex: 1;
  }
  .card__eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0;
  }
  .card__title { font-size: var(--fs-h4); font-weight: 700; margin: 0; color: var(--ink); }
  .card__text { font-size: var(--fs-small); line-height: 1.6; color: var(--ink-muted); margin: 0; }
  .card__go { color: var(--ink); margin-top: auto; padding-top: var(--sp-2); transition: translate var(--dur) var(--ease); }
  .card:hover .card__go { translate: 0.35rem 0; }
</style>
