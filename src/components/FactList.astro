---
/**
 * The receipt rule, as one component: every fact is a label on the left edge
 * and a value on the right edge, a hairline between rows, tabular numerals so
 * prices line up. Used across the site and the demos.
 */
import type { Fact } from '~/data/home';

interface Props {
  facts: Fact[];
  /** Show only the first n rows. */
  limit?: number;
  /** Skip the first n rows (for a "rest of the facts" disclosure). */
  from?: number;
  /** Row index to set bold, e.g. today in an hours list. */
  strong?: number;
  /** data attribute hook for client-side marking (hours). */
  hook?: string;
  class?: string;
  /** Bigger values, for a list that is the main thing on its card. */
  size?: 'sm' | 'md';
}
const { facts, limit, from = 0, strong, hook, class: klass = '', size = 'sm' } = Astro.props;
const rows = facts.slice(from, limit === undefined ? undefined : from + limit);
---
<dl class={`fact-list fact-list--${size} ${klass}`} data-fact-list={hook}>
  {rows.map((f, i) => (
    <div class="fact-list__row" data-strong={i === strong ? '' : undefined}>
      <dt>{f.label}</dt>
      <dd>{f.value}</dd>
    </div>
  ))}
</dl>

<style>
  .fact-list {
    margin: 0;
    width: 100%;
    max-width: 36rem;
  }
  .fact-list__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-4);
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--hair);
  }
  .fact-list__row:last-child { border-bottom: 0; }
  dt {
    flex: 0 1 auto;
    margin: 0;
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }
  dd {
    flex: 0 1 auto;
    margin: 0;
    text-align: right;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .fact-list--md dt,
  .fact-list--md dd { font-size: 0.9375rem; }
  .fact-list__row[data-strong] dt,
  .fact-list__row[data-strong] dd { color: var(--ink); font-weight: 700; }
</style>
