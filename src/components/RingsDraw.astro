---
import Eyebrow from './Eyebrow.astro';

interface Chapter { year: string; line: string; }
interface Props { chapters: Chapter[]; eyebrow?: string; }
const { chapters, eyebrow = 'Since 1957' } = Astro.props;
const radii = [148, 118, 88, 58, 30];
---
<section class="rings tone-pine" id="since" data-rings aria-labelledby="rings-title">
  <div class="wrap rings__inner">
    <div class="rings__art" aria-hidden="true">
      <svg viewBox="0 0 340 340" fill="none">
        {radii.map((r, i) => (
          <circle
            cx="170" cy="170" r={r}
            stroke={i === radii.length - 1 ? 'var(--bullseye)' : 'var(--cream-50)'}
            stroke-width={i === radii.length - 1 ? 2.4 : 1.5}
            opacity={i === radii.length - 1 ? 0.95 : 0.72}
            pathLength="1"
            data-ring
            style="stroke-dasharray:1;stroke-dashoffset:1"
          />
        ))}
        <circle cx="170" cy="170" r="12" fill="var(--bullseye)" data-ring-dot />
        <g data-ring-arrow>
          <path d="M170 170 L330 26" stroke="var(--cream-50)" stroke-width="2" stroke-linecap="round" />
          <path d="M330 26l-16 1.5M330 26l-1.5 16" stroke="var(--cream-50)" stroke-width="2" stroke-linecap="round" />
          <path d="M186 156l-11-2.5M198 144l-11-2.5" stroke="var(--ember)" stroke-width="2" stroke-linecap="round" />
        </g>
      </svg>
    </div>

    <div class="rings__copy">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 id="rings-title" class="visually-hidden">Sixty-nine years on Route 46</h2>
      <div class="rings__stage">
        {chapters.map((c, i) => (
          <p class="rings__chapter" data-ring-chapter data-first={i === 0 ? '' : undefined}>
            <span class="rings__year num">{c.year}</span>
            <span class="rings__line">{c.line}</span>
          </p>
        ))}
      </div>
    </div>
  </div>

  <!-- Reduced motion and small screens get the same facts as a plain grid. -->
  <div class="wrap rings__fallback">
    <p class="rings__fallback-eyebrow">{eyebrow}</p>
    <ol>
      {chapters.map((c) => (
        <li>
          <span class="rings__year num">{c.year}</span>
          <span class="rings__line">{c.line}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .rings {
    position: relative;
    background: var(--pine-900);
    color: var(--cream-50);
    overflow: hidden;
  }
  .rings__inner {
    display: none;
    min-height: 100svh;
    align-items: center;
    gap: var(--sp-8);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
  }
  @media (min-width: 48rem) { .rings__inner { display: grid; } }

  .rings__art { display: grid; place-items: center; }
  .rings__art svg { width: min(34rem, 46vw); height: auto; rotate: -90deg; }

  .rings__copy { max-width: 34rem; }
  .rings__stage { position: relative; min-height: 16rem; }
  .rings__chapter {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    gap: var(--sp-4);
    opacity: 0;
    margin: 0;
  }
  .rings__chapter[data-first] { opacity: 1; }
  .rings__year {
    font-size: clamp(3.5rem, 2rem + 5vw, 7rem);
    color: var(--ember);
    display: block;
  }
  .rings__line {
    font-size: var(--fs-lead);
    line-height: 1.4;
    color: rgba(248, 245, 238, 0.86);
    max-width: 24ch;
  }

  .rings__fallback { padding-block: var(--section-y); }
  .rings__fallback-eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--ember);
    margin: 0 0 var(--sp-6);
    display: flex;
    align-items: center;
    gap: 0.75em;
  }
  .rings__fallback-eyebrow::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
  }
  @media (min-width: 48rem) { .rings__fallback { display: none; } }
  .rings__fallback ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--sp-6) var(--sp-7);
  }
  .rings__fallback li {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    border-top: 1px solid rgba(248, 245, 238, 0.18);
    padding-top: var(--sp-4);
  }
  .rings__fallback .rings__year { font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4rem); }
  .rings__fallback .rings__line { font-size: var(--fs-small); line-height: 1.6; }

  @media (prefers-reduced-motion: reduce) {
    .rings__inner { display: none; }
    .rings__fallback { display: block; }
  }
</style>
