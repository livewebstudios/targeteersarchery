---
/**
 * The shot arrow as inline SVG, for the places GSAP has to move it: the Base
 * Camp hero flight, the Trailhead tab indicator, the Long Shot rail. Same art
 * as public/images/shot-arrow-brand*.svg (scripts/make-arrow.mjs), but every
 * colour is a CSS custom property so one component covers both grounds.
 *
 * Points right by default. Rotate the wrapper, not the paths.
 */
interface Props {
  /** 'brand': navy shaft for light glass. 'light': pale shaft for dark grounds. */
  tone?: 'brand' | 'light';
  class?: string;
  /** Accessible label. Decorative (hidden) when omitted. */
  title?: string;
}
const { tone = 'light', class: klass = '', title } = Astro.props;
// Gradient ids must be unique per instance on the page.
const uid = `ba${Math.random().toString(36).slice(2, 8)}`;
---
<svg
  class={`brand-arrow brand-arrow--${tone} ${klass}`}
  viewBox="0 0 300 34"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  focusable="false"
>
  <defs>
    <linearGradient id={`${uid}s`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="ba-shaft-hi" /><stop offset=".42" class="ba-shaft" /><stop offset="1" class="ba-shaft-lo" />
    </linearGradient>
    <linearGradient id={`${uid}p`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="ba-steel-hi" /><stop offset=".38" class="ba-steel" /><stop offset="1" class="ba-steel-lo" />
    </linearGradient>
    <linearGradient id={`${uid}v`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" class="ba-vane-lo" /><stop offset="1" class="ba-vane" />
    </linearGradient>
  </defs>
  <path class="ba-nock" d="M12 13.4h13v7.2H12a2.2 2.2 0 0 1-2.2-2.2v-2.8A2.2 2.2 0 0 1 12 13.4Z" />
  <rect class="ba-slot" x="9.4" y="16.1" width="7.6" height="1.8" rx=".9" />
  <rect x="23" y="14.1" width="248" height="5.8" rx="2.9" fill={`url(#${uid}s)`} />
  <rect class="ba-gleam" x="26" y="14.9" width="242" height="1.3" rx=".65" opacity=".5" />
  <path d="M28.6 14.3c0-6.4 2.8-10.2 7.6-11.2 9.6-2 19.2 3.4 27.2 11.2Z" fill={`url(#${uid}v)`} />
  <path class="ba-edge" d="M29.4 14.3c1.6-3 5-4.9 9.6-5.4 8-.9 16.4 2.2 23.2 5.4Z" opacity=".28" />
  <path d="M28.6 19.7c0 4.6 2.4 7.3 6.6 8.1 8.4 1.6 17.6-2.6 24.6-8.1Z" fill={`url(#${uid}v)`} opacity=".86" />
  <path class="ba-edge" d="M31.4 15c9.2-1.4 22.4-.7 32 2v1.3c-9.6-2.7-22.8-3.3-32-2Z" />
  <rect class="ba-wrap" x="68" y="14.1" width="4.4" height="5.8" />
  <rect class="ba-wrap" x="76" y="14.1" width="2" height="5.8" opacity=".7" />
  <rect class="ba-steel-lo-fill" x="266" y="13.5" width="5.6" height="7" rx="1.2" />
  <path d="M271.6 13.3c9.4.6 19.6 2.1 27.4 3.7-7.8 1.6-18 3.1-27.4 3.7Z" fill={`url(#${uid}p)`} />
  <path class="ba-gleam" d="M271.6 15.4c8.4.5 17.4 1.2 24.6 1.6-7.2.4-16.2 1.1-24.6 1.6Z" opacity=".35" />
</svg>

<style>
  .brand-arrow {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;

    --ba-steel-hi: #efeae1;
    --ba-steel: #a9a296;
    --ba-steel-lo: #5d564d;
    --ba-vane: var(--tgt-orange, #e46024);
    --ba-vane-lo: #b8440f;
  }
  .brand-arrow--brand {
    --ba-shaft-hi: #2a4a7a;
    --ba-shaft: #001840;
    --ba-shaft-lo: #000c22;
    --ba-gleam: #f8f8f4;
    --ba-nock: #0a2a5c;
    --ba-edge: #9c3a0a;
    --ba-wrap: #f8f8f4;
    --ba-slot: #e46024;
  }
  .brand-arrow--light {
    --ba-shaft-hi: #ffffff;
    --ba-shaft: #dfe6ee;
    --ba-shaft-lo: #9fb0c4;
    --ba-gleam: #ffffff;
    --ba-nock: #dfe6ee;
    --ba-edge: #fcba66;
    --ba-wrap: #e46024;
    --ba-slot: #e46024;
  }
  .ba-shaft-hi { stop-color: var(--ba-shaft-hi); }
  .ba-shaft { stop-color: var(--ba-shaft); }
  .ba-shaft-lo { stop-color: var(--ba-shaft-lo); }
  .ba-steel-hi { stop-color: var(--ba-steel-hi); }
  .ba-steel { stop-color: var(--ba-steel); }
  .ba-steel-lo { stop-color: var(--ba-steel-lo); }
  .ba-vane { stop-color: var(--ba-vane); }
  .ba-vane-lo { stop-color: var(--ba-vane-lo); }
  .ba-nock { fill: var(--ba-nock); }
  .ba-slot { fill: var(--ba-slot); }
  .ba-gleam { fill: var(--ba-gleam); }
  .ba-edge { fill: var(--ba-edge); }
  .ba-wrap { fill: var(--ba-wrap); }
  .ba-steel-lo-fill { fill: var(--ba-steel-lo); }
</style>
