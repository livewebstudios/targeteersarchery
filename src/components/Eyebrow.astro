---
interface Props { as?: 'p' | 'span' | 'h2' | 'div'; class?: string; }
const { as: Tag = 'p', class: klass = '' } = Astro.props;
---
<Tag class={`eyebrow ${klass}`}><slot /></Tag>

<style>
  .eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent, var(--ember));
    margin: 0 0 var(--sp-4);
    display: flex;
    align-items: center;
    gap: 0.75em;
  }
  /* The shop's target face leads every eyebrow, which puts the mark at the head
     of almost every section on the site. A 7KB PNG as a background rather than
     an <img> per instance: one cached request, no extra markup. */
  .eyebrow::before {
    content: '';
    width: 1em;
    height: 1em;
    flex: none;
    background: url('/images/target-mark.png') center / contain no-repeat;
  }
</style>
