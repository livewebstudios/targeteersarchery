---
/**
 * Formspree wrapper. Every form posts to its own endpoint (see
 * src/data/business.ts), carries a honeypot, sets a readable _subject, and
 * redirects to /thank-you/ on success. Client-side JS upgrades it to a fetch
 * submit with inline status so the visitor never loses the page — without JS
 * the plain POST + _next redirect still works.
 */
interface Props {
  action: string;
  subject: string;
  name: string;
  submitLabel?: string;
  class?: string;
  note?: string;
}
const { action, subject, name, submitLabel = 'Send', class: klass = '', note } = Astro.props;
const site = Astro.site?.href ?? 'https://targeteersarchery.com/';
const pending = action.includes('FORM_ID');
---
<form
  class={`form ${klass}`}
  id={name}
  name={name}
  method="POST"
  action={action}
  data-form
  novalidate
>
  <input type="hidden" name="_subject" value={subject} />
  <input type="hidden" name="_next" value={`${site}thank-you/`} />
  <!-- Honeypot: real people never see it, bots fill it in. -->
  <div class="form__pot" aria-hidden="true">
    <label>Leave this field empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="form__fields">
    <slot />
  </div>

  {note && <p class="form__note">{note}</p>}

  <div class="form__actions">
    <button class="form__submit" type="submit">{submitLabel}</button>
    <p class="form__status" role="status" aria-live="polite" data-form-status></p>
  </div>

  {pending && (
    /* Placeholder endpoint — Jon swaps the ID in src/data/business.ts. */
    <p class="form__pending">
      This form is not connected yet. Call <a href="tel:+12018437788">(201) 843-7788</a> and we
      will take care of you.
    </p>
  )}
</form>

<style>
  .form { display: grid; gap: var(--sp-5); }
  .form__pot {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .form__fields {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .form__note { font-size: var(--fs-small); color: var(--fg-faint); margin: 0; }
  .form__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-4); }

  .form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--ember-bright);
    color: var(--bark-900);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    padding: 1.05rem 2rem;
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease), translate var(--dur-fast) var(--ease);
  }
  .form__submit:hover { background: var(--ember-hover); translate: 0 -1px; }
  .form__submit[disabled] { opacity: 0.55; cursor: progress; translate: 0 0; }

  .form__status { margin: 0; font-size: var(--fs-small); }
  .form__status[data-state='error'] { color: var(--bullseye); }
  .form__status[data-state='ok'] { color: var(--pine-500); }

  .form__pending {
    font-size: var(--fs-small);
    color: var(--fg-faint);
    border-top: 1px solid var(--rule);
    padding-top: var(--sp-4);
    margin: 0;
  }
</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-form]')) {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submit = form.querySelector<HTMLButtonElement>('.form__submit');

    form.addEventListener('submit', async (e) => {
      if (!form.reportValidity()) { e.preventDefault(); return; }
      if (form.action.includes('FORM_ID')) return; // let the placeholder POST fail loudly
      e.preventDefault();

      submit?.setAttribute('disabled', '');
      if (status) { status.textContent = 'Sending…'; status.dataset.state = 'pending'; }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        window.location.href = '/thank-you/';
      } catch {
        submit?.removeAttribute('disabled');
        if (status) {
          status.textContent = 'That did not go through. Please call (201) 843-7788 and we will sort it out.';
          status.dataset.state = 'error';
        }
      }
    });
  }
</script>
