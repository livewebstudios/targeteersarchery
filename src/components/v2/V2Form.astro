---
/**
 * "Ask the Shop": a Formspree form. While the endpoint in business.ts is
 * still a placeholder (it contains FORM_ID), v2.ts stops the send and shows a
 * note under the button. With a real endpoint it posts normally.
 */
import { business } from '~/data/business';
import { visit } from '~/data/homeV2';

interface Props {
  /** Prefix for field ids, so two forms could share a page. */
  id?: string;
  class?: string;
}
const { id = 'ask', class: klass } = Astro.props;
---
<form class:list={['v2-form', klass]} action={business.formspree.contact} method="POST" data-v2-form>
  <input type="hidden" name="_subject" value="Question from the Targeteers website" />
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" hidden />

  <div class="v2-form__field">
    <label for={`${id}-name`}>Name</label>
    <input id={`${id}-name`} name="name" type="text" autocomplete="name" required />
  </div>
  <div class="v2-form__field">
    <label for={`${id}-phone`}>Phone</label>
    <input id={`${id}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel" required />
  </div>
  <div class="v2-form__field">
    <label for={`${id}-question`}>Your question</label>
    <textarea id={`${id}-question`} name="message" rows="4" required></textarea>
  </div>

  <button class="v2-form__button" type="submit">{visit.formButton}</button>
  <p class="v2-form__note" data-v2-form-note role="status" hidden></p>
</form>

<style is:global>
  .v2-form__field { display: grid; gap: 0.375rem; }
  .v2-form input:not([type='hidden']),
  .v2-form textarea { width: 100%; }
  .v2-form textarea { resize: vertical; }
  .v2-form__note[hidden] { display: none; }
</style>
