---
/**
 * Rob's logo, always an <img>, never recolored, redrawn, stretched or cropped.
 * Two files exist: the transparent one for light backgrounds and the one with
 * a white keyline for dark backgrounds.
 */
import { Image } from 'astro:assets';
import logoLight from '~/assets/brand/logo.png';
import logoDark from '~/assets/brand/logoRGB.png';

interface Props {
  /** The background the logo sits on. */
  on: 'light' | 'dark';
  /** Display height in px. Width follows the file's own ratio. */
  height: number;
  class?: string;
  /** Header logos are above the fold. */
  eager?: boolean;
}
const { on, height, class: klass, eager = false } = Astro.props;

const src = on === 'dark' ? logoDark : logoLight;
/* Never wider than 396px: half the source width keeps it sharp on retina. */
const width = Math.min(396, Math.round((height * src.width) / src.height));
const h = Math.round((width * src.height) / src.width);
---
<Image
  class:list={['v2-logo', klass]}
  src={src}
  alt="Targeteers Archery Pro Shop"
  width={width}
  height={h}
  widths={[width, Math.min(width * 2, src.width)]}
  sizes={`${width}px`}
  loading={eager ? 'eager' : 'lazy'}
/>
