---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/hero/PageHero.astro';
import Section from '~/components/Section.astro';
import Reveal from '~/components/Reveal.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Form from '~/components/Form.astro';
import Field from '~/components/Field.astro';
import Map from '~/components/Map.astro';
import HoursTable from '~/components/HoursTable.astro';
import Newsletter from '~/components/Newsletter.astro';
import OpenNowPill from '~/components/OpenNowPill.astro';
import Button from '~/components/Button.astro';
import SocialIcon from '~/components/icons/SocialIcon.astro';
import { business } from '~/data/business';
---
<Base
  title="Contact & Hours | Targeteers Archery · Saddle Brook, NJ"
  description="Call (201) 843-7788 or visit Targeteers Archery Pro Shop at 101 Route 46 West, Saddle Brook, NJ. Hours, directions, map and contact form."
  keywords={['Targeteers Archery contact', 'archery shop Saddle Brook NJ', 'bow shop hours North Jersey']}
  ogImage="/og/contact.jpg"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }]}
>
  <PageHero
    eyebrow="Contact"
    title="101 Route 46 West, Saddle Brook."
    lead="Fifteen minutes from most of Bergen County, with ample parking and a Sasquatch by the door."
    tone="cream"
  />

  <Section tone="cream">
    <div class="contact">
      <Reveal class="contact__form">
        <Eyebrow>Send a message</Eyebrow>
        <h2 class="shot-head">Ask us anything.</h2>
        <p class="contact__intro">
          For anything time-sensitive, like lane availability or whether a bow is back, the
          phone is faster.
        </p>
        <Form
          action={business.formspree.contact}
          subject="Website enquiry · targeteersarchery.com"
          name="contact"
          submitLabel="Send message"
        >
          <Field label="Name" name="name" required autocomplete="name" />
          <Field label="Email" name="email" type="email" required autocomplete="email" />
          <Field label="Phone" name="phone" type="tel" autocomplete="tel" />
          <Field label="Topic" name="topic" as="select" required
            options={['Lessons', 'Tuning or repairs', 'Buying a bow', 'The range', 'Leagues', 'Kids camp', 'Groups & events', 'Careers', 'Something else']} />
          <Field label="Message" name="message" as="textarea" required full
            placeholder="Tell us what you need. If it is about a bow, the make and model helps." />
        </Form>
      </Reveal>

      <aside class="contact__info">
        <Reveal delay={1}>
          <div class="info-card">
            <h2 class="info-card__title">The details</h2>
            <dl>
              <div>
                <dt>Phone</dt>
                <dd><a class="info-card__phone" href={business.phoneHref}>{business.phone}</a></dd>
              </div>
              <div>
                <dt>Address</dt>
                <dd>
                  <address>
                    <a href={business.mapsUrl} target="_blank" rel="noopener">
                      {business.address.street}<br />
                      {business.address.city}, {business.address.regionName} {business.address.postal}
                    </a>
                  </address>
                </dd>
              </div>
              <div>
                <dt>Email</dt>
                <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
              </div>
              <div>
                <dt>Right now</dt>
                <dd><OpenNowPill /></dd>
              </div>
            </dl>
            <div class="info-card__actions">
              <Button href={business.directionsUrl} variant="primary" external>Get directions</Button>
            </div>
            <ul class="info-card__social">
              <li><a href={business.socials.facebook} target="_blank" rel="noopener" aria-label="Facebook"><SocialIcon network="facebook" /></a></li>
              <li><a href={business.socials.instagram} target="_blank" rel="noopener" aria-label="Instagram"><SocialIcon network="instagram" /></a></li>
              <li><a href={business.socials.twitter} target="_blank" rel="noopener" aria-label="X"><SocialIcon network="twitter" /></a></li>
            </ul>
          </div>
        </Reveal>

        <Reveal delay={2}>
          <div class="info-card">
            <h2 class="info-card__title">Hours</h2>
            <HoursTable />
            <p class="info-card__note">
              Lanes are subject to lessons, leagues and events. Call ahead if you are making a
              special trip.
            </p>
          </div>
        </Reveal>

        <Reveal delay={3}>
          <div class="info-card"><Newsletter /></div>
        </Reveal>
      </aside>
    </div>
  </Section>

  <Section tone="linen" width="wide">
    <Map />
  </Section>
</Base>

<style>
  .contact { display: grid; gap: var(--sp-8); align-items: start; }
  @media (min-width: 64rem) { .contact { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--sp-9); } }
  .contact__intro { margin: var(--sp-4) 0 var(--sp-6); max-width: 44ch; }
  .contact__info { display: grid; gap: var(--sp-5); }

  .info-card {
    background: var(--cream-100);
    border: 1px solid var(--cream-200);
    border-radius: var(--radius-lg);
    padding: var(--sp-5);
  }
  .info-card__title {
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--ember);
    margin-bottom: var(--sp-4);
  }
  .info-card dl { display: grid; gap: var(--sp-4); margin: 0; }
  .info-card dt {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone-400);
    margin-bottom: 0.3rem;
  }
  .info-card dd { margin: 0; font-size: var(--fs-small); line-height: 1.6; }
  .info-card a:not(.btn) { color: var(--bark-700); text-decoration: none; transition: color var(--dur-fast) var(--ease); }
  .info-card a:not(.btn):hover { color: var(--ember); }
  .info-card address { font-style: normal; }
  .info-card__phone { font-family: var(--font-display); font-weight: 500; font-variant-numeric: tabular-nums; font-size: 1.5rem; }
  .info-card__actions { margin-top: var(--sp-5); }
  .info-card__social { display: flex; gap: var(--sp-3); list-style: none; margin: var(--sp-5) 0 0; padding: 0; }
  .info-card__social a {
    display: grid; place-items: center;
    width: 2.25rem; height: 2.25rem;
    border: 1px solid var(--cream-200);
    border-radius: 999px;
    color: var(--bark-500);
    background: var(--cream-50);
  }
  .info-card__social a:hover { border-color: var(--ember); color: var(--ember); }
  .info-card__note { margin-top: var(--sp-4); font-size: 0.75rem; color: var(--stone-400); }
</style>
