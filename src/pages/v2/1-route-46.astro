    .v2--route46 .r46-header[data-scrolled] .r46-header__bar { transform: translateY(-24px); }
    .v2--route46 .r46-header[data-scrolled] .r46-header__in { transform: translateY(12px); }
    .v2--route46 .r46-header__logo .v2-logo { height: 72px; }
    .v2--route46 .r46-header[data-scrolled] .v2-logo { transform: scale(0.75); }
    .v2--route46 .r46-menu-btn { display: none; }
    .v2--route46 .r46-nav { display: block; }
    .v2--route46 .r46-nav ul { display: flex; gap: clamp(1rem, 2.2vw, 2rem); }
    .v2--route46 .r46-nav a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      border-bottom: 2px solid transparent;
      color: var(--r46-forest);
      font-size: 0.875rem;
      font-weight: 700;
