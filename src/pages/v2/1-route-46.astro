      text-decoration: none;
      white-space: nowrap;
      transition: border-color var(--v2-t-hover) var(--v2-ease);
    }
    .v2--route46 .r46-nav a:hover,
    .v2--route46 .r46-nav a[aria-current] { border-bottom-color: var(--r46-tan-ink); }
  }

  /* ------------------------------------------------------------ mobile menu */
  .v2--route46 .r46-menu {
    position: fixed;
    inset: 0;
    z-index: 850;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1rem var(--r46-gutter) 2rem;
    overflow-y: auto;
    background: var(--r46-white);
  }
  .v2--route46 .r46-menu[hidden] { display: none; }
  .v2--route46 .r46-menu__close {
    align-self: flex-end;
