    object-position: center 72%;
  }
  @media (min-width: 48rem) {
    .v2--route46 .r46-hero__photo img { aspect-ratio: 21 / 9; max-height: 640px; }
  }
  .v2--route46 .r46-hero__copy {
    max-width: calc(55rem + 2 * var(--r46-gutter));
    margin-inline: auto;
    padding: clamp(2.5rem, 5vw, 4rem) var(--r46-gutter) 0;
