  .v2--route46 .r46-hunt__copy { max-width: 44rem; }
  .v2--route46 .r46-hunt h2 { color: var(--r46-white); font-size: clamp(1.625rem, 1.2rem + 2vw, 2.5rem); }
  .v2--route46 .r46-hunt p { margin-top: 1rem; font-size: 1.125rem; }
  .v2--route46 .r46-hunt .r46-btn { margin-top: 1.75rem; }
  /* Olive on a dark photo needs an edge to read as a button. */
  .v2--route46 .r46-hunt .r46-btn--primary { border-color: var(--r46-tan); }
  .v2--route46 .r46-hunt .r46-btn--primary:hover { background: var(--r46-forest); border-color: var(--r46-tan); }

  /* ------------------------------------------------------------------ about */
  .v2--route46 .r46-about { padding-block: var(--r46-section); background: var(--r46-cream); }
  .v2--route46 .r46-about__grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 64rem) {
    .v2--route46 .r46-about__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 35rem); gap: 4rem; }
  }
  .v2--route46 .r46-about h2 { margin-top: 0.5rem; }
  .v2--route46 .r46-about__copy > p:not(.r46-eyebrow) { max-width: 38rem; margin-top: 1rem; }
  .v2--route46 .r46-timeline {
    display: grid;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--r46-rule);
