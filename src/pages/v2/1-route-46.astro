  }
  .v2--route46 .r46-events__rows dt { font-family: var(--r46-serif); font-size: 1.125rem; font-weight: 700; }
  .v2--route46 .r46-events__rows dd { color: var(--r46-tan-ink); font-weight: 700; }
  .v2--route46 .r46-events__note { margin-top: 1.25rem; }

  /* ------------------------------------------------------------------ visit */
  .v2--route46 .r46-visit { padding-block: var(--r46-section); background: var(--r46-cream); }
  .v2--route46 .r46-visit__grid { display: grid; gap: 2.5rem; margin-top: 2rem; }
  @media (min-width: 64rem) {
    .v2--route46 .r46-visit__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr) minmax(0, 1.2fr); gap: 3.5rem; }
  }
  .v2--route46 .r46-visit h3 { margin-bottom: 0.875rem; padding-bottom: 0.625rem; border-bottom: 1px solid var(--r46-olive); }
  .v2--route46 .r46-visit address { font-style: normal; }
  .v2--route46 .r46-visit__phone { margin-block: 0 0.75rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  /* A phone number on its own line is a button on a phone. Give it 44px. */
  .v2--route46 .r46-visit__phone a,
  .v2--route46 .r46-footer__col p a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .v2--route46 .r46-visit__formline { margin-bottom: 1.25rem; }
  .v2--route46 .r46-visit .v2-hours th,
  .v2--route46 .r46-visit .v2-hours td { padding-block: 0.5rem; border-bottom: 1px solid var(--r46-rule); }
  .v2--route46 .r46-visit .v2-hours tr[data-today] th,
  .v2--route46 .r46-visit .v2-hours tr[data-today] td { color: var(--r46-olive); font-weight: 700; }
  .v2--route46 .r46-visit .v2-hours tr[data-today] th::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--r46-olive);
  }

  .v2--route46 .v2-form { display: grid; gap: 1rem; }
  .v2--route46 .v2-form label { font-size: 0.875rem; font-weight: 700; letter-spacing: 0.04em; }
  .v2--route46 .v2-form input:not([type='hidden']),
  .v2--route46 .v2-form textarea {
    padding: 0.75rem 0.875rem;
