---
/**
 * Demo 1: ROUTE 46. Rob's old home page, grown up.
 *
 * Section for section it is his old site: white header, his six links, the
 * showroom photo with nothing on it, serif capital headlines in green and tan,
 * his badges, his three tabbed boxes, a forest band of white target cards, the
 * hunting band, a dark green footer. What changed is the craft: real contrast,
 * real spacing, facts on the cards, a page that works on a phone.
 *
 * Signature move: the arrows find the targets.
 *
 * All copy comes from src/data/homeV2.ts. Nothing here links to an inner page.
 */
import '@fontsource/libre-baskerville/400.css';
import '@fontsource/libre-baskerville/400-italic.css';
import '@fontsource/libre-baskerville/700.css';
import '@fontsource-variable/nunito-sans';

import headlineFont from '@fontsource/libre-baskerville/files/libre-baskerville-latin-700-normal.woff2?url';
import { Image } from 'astro:assets';
import V2Base from '~/layouts/V2Base.astro';
import V2Logo from '~/components/v2/V2Logo.astro';
import V2OpenNow from '~/components/v2/V2OpenNow.astro';
import V2Hours from '~/components/v2/V2Hours.astro';
import V2Form from '~/components/v2/V2Form.astro';
import V2Arrow from '~/components/v2/V2Arrow.astro';
import V2Brands from '~/components/v2/V2Brands.astro';
import SocialIcon from '~/components/icons/SocialIcon.astro';
import { business } from '~/data/business';
import {
  v2Nav, call, callShort, directions, hero, proof, welcome, team, mission, dealers,
  offerings, hunt, about, events, visit, footer, photos, v2Widths,
} from '~/data/homeV2';

const year = new Date().getFullYear();
const socials = [
  { network: 'facebook', href: business.socials.facebook },
  { network: 'instagram', href: business.socials.instagram },
  { network: 'twitter', href: business.socials.twitter },
] as const;
---
<V2Base
  demo={1}
  theme="route46"
  title="Targeteers Archery Pro Shop | Demo 1, Route 46"
  description={hero.lead}
>
  <link slot="head" rel="preload" as="font" type="font/woff2" href={headlineFont} crossorigin />

  <header class="v2-banner" slot="header">
    <div class="r46-util">
      <div class="r46-wrap r46-util__in">
        <p class="r46-util__left">
          <V2OpenNow />
          <span class="r46-util__addr">{business.address.street}, {business.address.city}, {business.address.region}</span>
        </p>
        <div class="r46-util__right">
          <a class="r46-util__phone" href={business.phoneHref}>{business.phone}</a>
          <ul class="r46-social" role="list">
            {socials.map((s) => (
              <li><a href={s.href} target="_blank" rel="noopener"><SocialIcon network={s.network} size={18} /></a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="r46-header" data-v2-header>
      <div class="r46-header__bar">
        <div class="r46-wrap r46-header__in">
          <a class="r46-header__logo" href="#top"><V2Logo on="light" height={72} eager /></a>
          <nav class="r46-nav" aria-label="Main" data-v2-nav>
            <ul role="list">
              {v2Nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
          </nav>
          <button class="r46-menu-btn" type="button" aria-expanded="false" aria-controls="r46-menu" data-v2-menu-button>MENU</button>
        </div>
      </div>
    </div>

    <div class="r46-menu" id="r46-menu" data-v2-menu hidden>
      <button class="r46-menu__close" type="button" data-v2-menu-close>CLOSE</button>
      <nav aria-label="Menu">
        <ul role="list">
          {v2Nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <div class="r46-menu__actions">
        <a class="r46-btn r46-btn--primary" href={call.href}>{call.label}</a>
        <a class="r46-btn r46-btn--secondary" href={directions.href} target="_blank" rel="noopener">{directions.label}</a>
      </div>
    </div>
  </header>

  {/* ------------------------------------------------------------------ hero */}
  <section class="r46-hero" aria-labelledby="r46-h1">
    <div class="r46-hero__photo">
      <Image
        src={photos.hero1.src}
        alt={photos.hero1.alt}
        widths={[640, 960, 1280, 1920, 2560, 3200]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="r46-hero__copy">
      <p class="r46-eyebrow">{hero.eyebrow}</p>
      <h1 id="r46-h1"><span>{hero.h1}</span></h1>
      <p class="r46-lead">{hero.lead}</p>
      <div class="r46-actions">
        <a class="r46-btn r46-btn--primary" href={call.href}>{call.label}</a>
        <a class="r46-btn r46-btn--secondary" href={directions.href} target="_blank" rel="noopener">{directions.label}</a>
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------------- proof */}
  <!-- CONFIRM: award wording. The old About page says "East Coast Dealer of the Year". The badge says 2007. -->
  <div class="r46-proof">
    <div class="r46-wrap">
      <ul class="r46-proof__badges" role="list" data-reveal>
        {photos.badges.map((b) => (
          <li><Image src={b.src} alt={b.alt} width={104} widths={v2Widths(b.src, 104)} sizes="104px" loading="lazy" /></li>
        ))}
      </ul>
      <ul class="r46-proof__row" role="list" data-reveal>
        {proof.map((p) => (
          <li>
            <p class="r46-proof__big">{p.big}</p>
            <p class="r46-proof__label">{p.label}</p>
            <p class="r46-proof__note">{p.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>

  {/* -------------------------------------------------- welcome, team, mission */}
  <div class="r46-welcome">
    <div class="r46-wrap">
      <p class="r46-welcome__body" data-reveal>{welcome.body}</p>
      <div class="r46-boxes">
        <section class="r46-box" aria-labelledby="r46-team" data-reveal>
          <h2 class="r46-box__tab" id="r46-team">{team.title}</h2>
          <p>{team.body}</p>
        </section>
        <section class="r46-box" aria-labelledby="r46-mission" data-reveal>
          <h2 class="r46-box__tab" id="r46-mission">{mission.title}</h2>
          <p>{mission.body}</p>
          <p class="r46-pledge">{mission.pledge}</p>
        </section>
        <section class="r46-box" aria-labelledby="r46-dealer" data-reveal>
          <h2 class="r46-box__tab" id="r46-dealer">{dealers.title}</h2>
          <p>{dealers.line}</p>
          <V2Brands mode="color" maxWidth={120} maxHeight={40} />
        </section>
      </div>
    </div>
  </div>

  {/* ------------------------------------------------------------- offerings */}
  <!-- CONFIRM: range distance, 27 or 28 yards. -->
  <!-- CONFIRM: 2026 lesson prices. -->
  <!-- CONFIRM: current league schedule. -->
  <div class="r46-offer" data-r46-offer>
    <Image
      class="r46-offer__bg"
      src={photos.forest.src}
      alt=""
      widths={[640, 960, 1280, 1920]}
      sizes="(min-width: 1920px) 1920px, 100vw"
      quality={60}
      loading="lazy"
    />
    <div class="r46-wrap r46-offer__grid">
      {offerings.map((o) => (
        <section class="r46-card" id={o.id} aria-labelledby={`r46-${o.id}-title`}>
          <div class="r46-card__target">
            <Image src={photos.target.src} alt="" width={72} height={72} widths={[72, 144]} sizes="72px" loading="lazy" />
            <span class="r46-shot"><V2Arrow length={92} class="r46-shot__arrow" /></span>
          </div>
          <h2 id={`r46-${o.id}-title`}>{o.title}</h2>
          <p class="r46-card__line">{o.line}</p>
          <dl class="r46-facts">
            {o.facts.map((f) => (
              <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </div>

  {/* ------------------------------------------------------------- hunt band */}
  <section class="r46-hunt" aria-labelledby="r46-hunt-title">
    <Image
      class="r46-hunt__bg"
      src={photos.hunt1.src}
      alt=""
      widths={[640, 960, 1280, 1920]}
      sizes="(min-width: 1920px) 1920px, 100vw"
      quality={60}
      loading="lazy"
    />
    <div class="r46-hunt__copy" data-reveal>
      <h2 id="r46-hunt-title">{hunt.title}</h2>
      <p>{hunt.body}</p>
      <a class="r46-btn r46-btn--primary" href={callShort.href}>{callShort.label}</a>
    </div>
  </section>

  {/* ----------------------------------------------------------------- about */}
  <section class="r46-about" id="about" aria-labelledby="r46-about-title">
    <div class="r46-wrap">
      <div class="r46-about__grid">
        <div class="r46-about__copy" data-reveal>
          <p class="r46-eyebrow">{about.eyebrow}</p>
          <h2 id="r46-about-title">{about.title}</h2>
          {about.body.map((para) => <p>{para}</p>)}
          <ol class="r46-timeline" role="list">
            {about.timeline.map((t) => (
              <li><span class="r46-timeline__year">{t.year}</span><span>{t.line}</span></li>
            ))}
          </ol>
        </div>
        <div class="r46-about__photo" data-reveal>
          <Image
            src={photos.then.src}
            alt={photos.then.alt}
            widths={v2Widths(photos.then.src, 360, 560)}
            sizes="(min-width: 38rem) 560px, calc(100vw - 2rem)"
            loading="lazy"
          />
        </div>
      </div>

      <div class="r46-archive" data-reveal>
        <h3>{about.archiveTitle}</h3>
        <ul role="list">
          {photos.archive.map((a) => (
            <li>
              <Image
                src={a.src}
                alt={a.alt}
                widths={v2Widths(a.src, 160, 320)}
                sizes="(min-width: 64rem) 320px, 30vw"
                loading="lazy"
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- events */}
  <section class="r46-events" id="events" aria-labelledby="r46-events-title">
    <div class="r46-wrap r46-events__in" data-reveal>
      <h2 id="r46-events-title">{events.title}</h2>
      <dl class="r46-events__rows">
        {events.items.map((e) => (
          <div><dt>{e.name}</dt><dd>{e.when}</dd></div>
        ))}
      </dl>
      <p class="r46-events__note">{events.note}</p>
    </div>
  </section>

  {/* ----------------------------------------------------------------- visit */}
  <section class="r46-visit" id="visit" aria-labelledby="r46-visit-title">
    <div class="r46-wrap">
      <h2 id="r46-visit-title">{visit.title}</h2>
      <div class="r46-visit__grid">
        <div data-reveal>
          <h3>Hours</h3>
          <V2Hours />
        </div>
        <div data-reveal>
          <h3>Location</h3>
          <address>
            {business.address.street}<br />
            {business.address.city}, {business.address.region} {business.address.postal}
          </address>
          <p class="r46-visit__phone"><a href={business.phoneHref}>{business.phone}</a></p>
          <a class="r46-btn r46-btn--secondary" href={directions.href} target="_blank" rel="noopener">{directions.label}</a>
        </div>
        <div data-reveal>
          <h3>{visit.formTitle}</h3>
          <p class="r46-visit__formline">{visit.formLine}</p>
          <V2Form />
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- footer */}
  <footer class="r46-footer" slot="footer">
    <div class="r46-wrap r46-footer__cols">
      <div class="r46-footer__col">
        <Image class="r46-footer__target" src={photos.target.src} alt="" width={48} height={48} widths={[48, 96]} sizes="48px" loading="lazy" />
        <V2Logo on="dark" height={64} />
        <p>{footer.family}</p>
        <p class="r46-footer__tagline">{footer.tagline}</p>
      </div>
      <div class="r46-footer__col">
        <Image class="r46-footer__target" src={photos.target.src} alt="" width={48} height={48} widths={[48, 96]} sizes="48px" loading="lazy" />
        <h2>{events.title}</h2>
        <dl class="r46-footer__events">
          {events.items.map((e) => (
            <div><dt>{e.name}</dt><dd>{e.when}</dd></div>
          ))}
        </dl>
      </div>
      <div class="r46-footer__col">
        <Image class="r46-footer__target" src={photos.target.src} alt="" width={48} height={48} widths={[48, 96]} sizes="48px" loading="lazy" />
        <h2>Hours</h2>
        <V2Hours />
      </div>
      <div class="r46-footer__col">
        <Image class="r46-footer__target" src={photos.target.src} alt="" width={48} height={48} widths={[48, 96]} sizes="48px" loading="lazy" />
        <h2>Location</h2>
        <address>
          {business.address.street}<br />
          {business.address.city}, {business.address.region} {business.address.postal}
        </address>
        <p><a href={business.phoneHref}>{business.phone}</a></p>
        <p><a href={directions.href} target="_blank" rel="noopener">{directions.label}</a></p>
      </div>
    </div>

    <div class="r46-wrap r46-footer__links">
      <nav aria-label="Footer">
        <ul role="list">
          {v2Nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <p class="r46-footer__email">{business.email}</p>
      <ul class="r46-social" role="list">
        {socials.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener"><SocialIcon network={s.network} size={20} /></a></li>
        ))}
      </ul>
    </div>

    <div class="r46-footer__legal">
      <div class="r46-wrap r46-footer__legal-in">
        <p>&copy; {year} {business.name}</p>
        <a class="r46-footer__lws" href="https://livewebstudios.com" target="_blank" rel="noopener">
          <img src="../../images/verifiedsecured.png" alt="Verified and Secured by Live Web Studios" width="150" height="37" loading="lazy" decoding="async" />
          <span>{footer.credit}</span>
        </a>
      </div>
    </div>
  </footer>
</V2Base>

<script>
  /* Signature move: the arrows find the targets. This only decides when. The
     flight, the stagger and the quiver are CSS, switched on by .is-hit. */
  const band = document.querySelector<HTMLElement>('[data-r46-offer]');
  const cards = band ? Array.from(band.querySelectorAll<HTMLElement>('.r46-card')) : [];
  const hit = (el: Element) => el.classList.add('is-hit');

  if (band && 'IntersectionObserver' in window) {
    if (window.matchMedia('(max-width: 47.99rem)').matches) {
      // Phone: the cards stack, so each arrow lands as its own card enters.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            hit(e.target);
            io.unobserve(e.target);
          }
        },
        { threshold: 0.3 },
      );
      cards.forEach((c) => io.observe(c));
    } else {
      // 30 percent of the band in view, or as close to it as a short window allows.
      const threshold = Math.min(0.3, (window.innerHeight * 0.6) / Math.max(band.offsetHeight, 1));
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          cards.forEach(hit);
          io.disconnect();
        },
        { threshold },
      );
      io.observe(band);
    }
  } else {
    cards.forEach(hit);
  }
</script>

<style is:global>
  /* ========================================================================
     Demo 1: ROUTE 46. Every rule lives under .v2--route46.
     Tokens sampled from Rob's old site. Tan is decoration and dark-ground
     text only: tan on white is 2.98:1 and never carries text.
     ======================================================================== */
  .v2--route46 {
    --r46-forest: #142a13;   /* utility bar, footer */
    --r46-deep: #0e1c0c;     /* copyright bar */
    --r46-olive: #3b5400;    /* subheads, borders, primary button */
    --r46-tan: #af9164;      /* his headline tan: decoration, dark grounds */
    --r46-tan-ink: #7a5c2e;  /* tan for text on light */
    --r46-white: #ffffff;
    --r46-cream: #f6f1e7;
    --r46-ink: #262626;
    --r46-rule: #d9d2c3;
    --r46-tan-hi: #c4aa82;   /* hover on the tan button */
    --r46-field: #6f6a5f;    /* form field edge, over 3:1 on white and cream */
    /* The same colors as channels, for washes, shadows and hairlines. */
    --r46-white-rgb: 255, 255, 255;
    --r46-forest-rgb: 20, 42, 19;
    --r46-deep-rgb: 14, 28, 12;

    --r46-serif: 'Libre Baskerville', Georgia, 'Times New Roman', serif;
    --r46-sans: 'Nunito Sans Variable', 'Nunito Sans', system-ui, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
    --r46-gutter: clamp(1rem, 4vw, 2.5rem);
    --r46-section: clamp(3.5rem, 7vw, 6rem);

    --v2-header-h: 72px;
    --v2-bar-bg: var(--r46-forest);
    --v2-bar-fg: var(--r46-white);
    --v2-bar-line: rgba(var(--r46-white-rgb), 0.24);

    background: var(--r46-white);
    color: var(--r46-ink);
    font-family: var(--r46-sans);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .v2--route46 .r46-wrap {
    width: 100%;
    max-width: 77.5rem;
    margin-inline: auto;
    padding-inline: var(--r46-gutter);
  }

  /* Bare element rules stop at the gate, which shares this <body>. :where()
     keeps the exclusion from adding an ID to the specificity. */
  .v2--route46 :is(h1, h2, h3):where(:not(#site-gate *)) {
    font-family: var(--r46-serif);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.25;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .v2--route46 h2 { font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2rem); color: var(--r46-olive); }
  .v2--route46 h3 { font-size: 1.0625rem; color: var(--r46-olive); }
  .v2--route46 p:where(:not(#site-gate *)) { text-wrap: pretty; }

  .v2--route46 .r46-eyebrow {
    color: var(--r46-tan-ink);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ---------------------------------------------------------------- buttons */
  .v2--route46 .r46-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.75rem 1.5rem;
    border: 2px solid transparent;
    border-radius: 2px;
    font-family: var(--r46-sans);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color var(--v2-t-hover) var(--v2-ease), border-color var(--v2-t-hover) var(--v2-ease), color var(--v2-t-hover) var(--v2-ease);
  }
  .v2--route46 .r46-btn--primary { background: var(--r46-olive); border-color: var(--r46-olive); color: var(--r46-white); }
  .v2--route46 .r46-btn--primary:hover { background: var(--r46-forest); border-color: var(--r46-forest); }
  /* His old button exactly: tan fill, forest text, forest border. */
  .v2--route46 .r46-btn--secondary { background: var(--r46-tan); border-color: var(--r46-forest); color: var(--r46-forest); }
  .v2--route46 .r46-btn--secondary:hover { background: var(--r46-tan-hi); }
  .v2--route46 .r46-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
  /* The base focus ring takes the text color. A white-on-olive button on a
     white page would get a white ring, so filled buttons name their ring. */
  .v2--route46 .r46-btn--primary:focus-visible,
  .v2--route46 .v2-form__button:focus-visible { outline-color: var(--r46-olive); }
  .v2--route46 .r46-hunt .r46-btn--primary:focus-visible { outline-color: var(--r46-white); }

  /* ------------------------------------------------------------ utility bar */
  .v2--route46 .r46-util { background: var(--r46-forest); color: var(--r46-white); font-size: 0.8125rem; }
  .v2--route46 .r46-util__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
  }
  .v2--route46 .r46-util__left { display: flex; align-items: center; gap: 1.5rem; min-width: 0; }
  .v2--route46 .r46-util__addr { display: none; }
  .v2--route46 .r46-util__right { display: flex; align-items: center; gap: 1rem; }
  .v2--route46 .r46-util__phone {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  .v2--route46 .r46-util__phone:hover { text-decoration: underline; }
  .v2--route46 .v2-open {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .v2--route46 .v2-open__dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--r46-tan); }
  .v2--route46 .v2-open[data-state='closed'] .v2-open__dot { background: transparent; box-shadow: inset 0 0 0 1.5px var(--r46-tan); }

  .v2--route46 .r46-social { display: none; align-items: center; gap: 0.25rem; }
  .v2--route46 .r46-social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    transition: color var(--v2-t-hover) var(--v2-ease);
  }
  .v2--route46 .r46-social a:hover { color: var(--r46-tan); }
  @media (min-width: 40rem) {
    .v2--route46 .r46-social { display: flex; }
  }
  /* 320px: the open line and the phone share one row with nothing to spare. */
  @media (max-width: 22.4rem) {
    .v2--route46 .r46-util { font-size: 0.75rem; }
    .v2--route46 .r46-util__in { gap: 0.5rem; }
    .v2--route46 .v2-open { gap: 0.375rem; letter-spacing: 0.02em; }
    .v2--route46 .r46-util__phone { letter-spacing: 0; }
  }
  @media (min-width: 64rem) {
    .v2--route46 .r46-util__addr { display: inline; }
