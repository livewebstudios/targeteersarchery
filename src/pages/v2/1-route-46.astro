  }
  @media (min-width: 36rem) {
    .v2--route46 .r46-timeline { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  /* counter-three-men.jpg: never past 560px. */
  .v2--route46 .r46-about__photo img { width: 100%; max-width: 560px; border: 1px solid var(--r46-rule); }
  .v2--route46 .r46-archive { margin-top: clamp(3rem, 6vw, 4.5rem); padding-top: 2rem; border-top: 1px solid var(--r46-rule); }
  .v2--route46 .r46-archive ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 320px));
    gap: clamp(0.5rem, 2vw, 1.5rem);
    margin-top: 1.25rem;
  }
  /* Archive photos: never past 320px. */
  .v2--route46 .r46-archive img {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 25%;
    border: 1px solid var(--r46-rule);
  }

  /* ----------------------------------------------------------------- events */
  .v2--route46 .r46-events { padding-block: var(--r46-section); }
  .v2--route46 .r46-events__in { max-width: 55rem; }
  .v2--route46 .r46-events__rows { margin-top: 1.5rem; border-bottom: 1px solid var(--r46-rule); }
  .v2--route46 .r46-events__rows > div {
    display: flex;
    flex-wrap: wrap;
