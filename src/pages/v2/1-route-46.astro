  }
  .v2--route46 .r46-proof__note { margin-top: 0.125rem; color: var(--r46-tan-ink); font-size: 0.9375rem; line-height: 1.4; }
  /* Four across only once TOP 100 can hold one line. Two by two before that. */
  @media (min-width: 60rem) {
    .v2--route46 .r46-proof__row { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .v2--route46 .r46-proof__row li:nth-child(n) { border-top: 0; border-left: 0; }
    .v2--route46 .r46-proof__row li:nth-child(n + 2) { border-left: 1px solid var(--r46-rule); }
  }

  /* --------------------------------------------------- welcome, team, mission */
  .v2--route46 .r46-welcome { padding-block: var(--r46-section); }
  .v2--route46 .r46-welcome__body { max-width: 45rem; margin-inline: auto; font-size: 1.1875rem; line-height: 1.7; text-align: center; }
  .v2--route46 .r46-boxes { display: grid; gap: 2.75rem 1.5rem; margin-top: clamp(3rem, 6vw, 4.5rem); }
  @media (min-width: 64rem) {
    .v2--route46 .r46-boxes { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  /* His tabbed box: an olive border with the title sitting on the top edge. */
  .v2--route46 .r46-box {
    position: relative;
    padding: 2.25rem 1.5rem 1.75rem;
    border: 1px solid var(--r46-olive);
  }
  .v2--route46 .r46-box__tab {
    position: absolute;
    top: 0;
    left: 1rem;
    max-width: calc(100% - 2rem);
    padding-inline: 0.75rem;
    transform: translateY(-50%);
    background: var(--r46-white);
    font-size: 1.0625rem;
    line-height: 1.2;
    white-space: nowrap;
  }
  .v2--route46 .r46-pledge {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--r46-rule);
    color: var(--r46-olive);
    font-family: var(--r46-serif);
    font-size: 1.0625rem;
    font-style: italic;
    line-height: 1.6;
  }
  .v2--route46 .v2-brands {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
    margin-top: 1.5rem;
  }
  .v2--route46 .v2-brands__item { display: grid; place-items: center; min-height: 2.5rem; }

  /* -------------------------------------------------------------- offerings */
  .v2--route46 .r46-offer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: calc(var(--r46-section) + 36px) var(--r46-section);
    background: var(--r46-forest);
  }
  /* Never wider than the 1920px source. Past that the forest green takes over. */
  .v2--route46 .r46-offer__bg,
  .v2--route46 .r46-hunt__bg {
    position: absolute;
    inset: 0;
    left: 50%;
    z-index: -2;
    width: 100%;
    max-width: 1920px;
    height: 100%;
    transform: translateX(-50%);
    object-fit: cover;
  }
  .v2--route46 .r46-offer::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(var(--r46-forest-rgb), 0.78);
  }
  .v2--route46 .r46-offer__grid { display: grid; gap: calc(2rem + 36px) 1.5rem; }
  @media (min-width: 48rem) {
    .v2--route46 .r46-offer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .v2--route46 .r46-offer__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .v2--route46 .r46-card {
    position: relative;
    padding: calc(36px + 1.25rem) 1.5rem 1.5rem;
    background: var(--r46-white);
    scroll-margin-top: calc(var(--v2-header-h) + 1rem + 36px);
  }
  /* The target sits half over the card's top edge. */
  .v2--route46 .r46-card__target {
    position: absolute;
    top: -36px;
    left: 50%;
    width: 72px;
    height: 72px;
    margin-left: -36px;
  }
  .v2--route46 .r46-card h2 { font-size: 1.25rem; text-align: center; }
  .v2--route46 .r46-card__line { margin-top: 0.5rem; text-align: center; line-height: 1.5; }
  .v2--route46 .r46-facts { margin-top: 1.25rem; font-size: 0.9375rem; line-height: 1.4; }
  .v2--route46 .r46-facts > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5625rem;
    border-top: 1px solid var(--r46-rule);
  }
  .v2--route46 .r46-facts dt { flex: 1 1 auto; }
  .v2--route46 .r46-facts dd {
    flex: 0 1 auto;
    max-width: 62%;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  /* Signature move: the arrows find the targets.
     The outer span sets the angle the arrow sticks in at, with its point on
     the bullseye. The arrow inside flies along that line, then quivers. */
  .v2--route46 .r46-shot {
    position: absolute;
    top: 50%;
    right: 50%;
    width: 92px;
    margin-top: -4.6px;
    color: var(--r46-forest);
    --v2-arrow-fletch: var(--r46-tan);
    transform: rotate(-18deg);
    transform-origin: 100% 50%;
    pointer-events: none;
  }
  .v2--route46 .r46-shot__arrow { max-width: none; transform-origin: 100% 50%; }
  .v2-js .v2--route46 .r46-shot__arrow { opacity: 0; transform: translateX(-140px); }
  .v2-js .v2--route46 .r46-card.is-hit .r46-shot__arrow {
    animation:
      r46-fly 500ms cubic-bezier(0.16, 0.8, 0.3, 1) var(--r46-delay, 0ms) forwards,
      r46-quiver 300ms ease-in-out calc(var(--r46-delay, 0ms) + 500ms);
  }
  .v2--route46 .r46-card:nth-child(2) { --r46-delay: 180ms; }
  .v2--route46 .r46-card:nth-child(3) { --r46-delay: 360ms; }
  .v2--route46 .r46-card:nth-child(4) { --r46-delay: 540ms; }
  .v2--route46 .r46-card:nth-child(5) { --r46-delay: 720ms; }
  .v2--route46 .r46-card:nth-child(6) { --r46-delay: 900ms; }
  /* On a phone each arrow lands when its own card enters. No queue. */
  @media (max-width: 47.99rem) {
    .v2--route46 .r46-card:nth-child(n) { --r46-delay: 0ms; }
  }
  @keyframes r46-fly {
    from { opacity: 0; transform: translateX(-140px); }
    20% { opacity: 1; }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes r46-quiver {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(3deg); }
    50% { transform: rotate(-3deg); }
    75% { transform: rotate(1.5deg); }
  }
  /* Reduced motion, or a script that never ran: every arrow already home. */
  .v2-reveal-all .v2--route46 .r46-shot__arrow { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .v2-js .v2--route46 .r46-shot__arrow,
    .v2-js .v2--route46 .r46-card.is-hit .r46-shot__arrow { opacity: 1; transform: none; animation: none; }
  }

  /* -------------------------------------------------------------- hunt band */
  .v2--route46 .r46-hunt {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: 440px;
    padding: var(--r46-section) var(--r46-gutter);
    overflow: hidden;
    /* Two forest bands meet here. One tan rule keeps them apart. */
    border-top: 3px solid var(--r46-tan);
    background: var(--r46-deep);
    color: var(--r46-white);
    text-align: center;
  }
  .v2--route46 .r46-hunt::before {
    content: '';
