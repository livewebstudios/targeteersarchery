---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/hero/PageHero.astro';
import Section from '~/components/Section.astro';
import Reveal from '~/components/Reveal.astro';
import PostCard from '~/components/PostCard.astro';
import ContactBand from '~/components/ContactBand.astro';
import { getPosts, CATEGORIES, categorySlug } from '~/utils/posts';

const posts = await getPosts();
const counts = new Map<string, number>();
for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
---
<Base
  title="Insights | Targeteers Archery · Saddle Brook, NJ"
  description="Notes from behind the counter at Targeteers Archery: bow tuning, gear, hunting season prep, getting started, kids and leagues. Written by the people who do the work."
  keywords={['archery blog NJ', 'bow tuning advice', 'archery tips North Jersey']}
  ogImage="/og/insights.jpg"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Insights', path: '/insights/' }]}
>
  <PageHero
    eyebrow="Insights"
    title="Notes from behind the counter."
    lead="Tuning, gear, hunting season and the occasional bit of family history. No filler, no listicles about the top ten anything."
    tone="cream"
  />

  <Section tone="cream">
    <nav class="cats" aria-label="Post categories">
      <a href="/insights/" aria-current="page">All <span>{posts.length}</span></a>
      {CATEGORIES.filter((c) => counts.has(c)).map((c) => (
        <a href={`/insights/category/${categorySlug(c)}/`}>{c} <span>{counts.get(c)}</span></a>
      ))}
    </nav>

    <div class="posts">
      {posts.map((post, i) => (
        <Reveal delay={Math.min(i, 5)}><PostCard post={post} level={2} loading={i < 3 ? 'eager' : 'lazy'} /></Reveal>
      ))}
    </div>

    <p class="rss">
      <a href="/rss.xml">Subscribe by RSS</a>
    </p>
  </Section>

  <ContactBand
    title="Rather just ask somebody?"
    body="Everything on this page started as a question at the counter. Call and skip the reading."
    primary={{ label: 'Call the shop', href: 'tel:+12018437788' }}
    secondary={{ label: 'Contact us', href: '/contact/' }}
  />
</Base>

<style>
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--sp-7);
    padding-bottom: var(--sp-5);
    border-bottom: 1px solid var(--rule);
  }
  .cats a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--cream-200);
    border-radius: 999px;
    color: var(--bark-500);
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .cats a:hover { border-color: var(--ember); color: var(--ember); }
  .cats a[aria-current='page'] { background: var(--tgt-white); border-color: var(--tgt-white); color: var(--tgt-navy); }
  .cats span { font-variant-numeric: tabular-nums; color: var(--stone-400); }
  .cats a[aria-current='page'] span { color: rgba(0, 24, 64, 0.75); }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: clamp(1rem, 0.4rem + 1.6vw, 1.75rem);
  }
  .posts > :global(*) { display: flex; }
  .posts > :global(*) > :global(*) { width: 100%; }

  .rss { margin-top: var(--sp-8); font-size: var(--fs-small); }
  .rss a { color: var(--ember); }
</style>
