---
/**
 * /demos/ : the review index. Logo, one line of intro, three cards. Review
 * aid only; the whole /demos/ folder comes out once a direction is chosen.
 */
import { Image, Picture } from 'astro:assets';
import DemoBase from '~/layouts/DemoBase.astro';
import logoRGB from '~/assets/brand/logoRGB.png';
import timber from '~/assets/demo-scenes/timber.jpg';
import ridge from '~/assets/demo-scenes/ridge.jpg';
import poster from '~/assets/hero/hero-poster.jpg';
import dusk from '~/assets/demo-scenes/dusk.jpg';
import ArrowRightIcon from '~/components/icons/ArrowRightIcon.astro';
import { demos } from '~/data/home';

const thumbs = [ridge, poster, dusk];
const glassOf = ['Smoke glass', 'Frost glass', 'Clear glass'];
---
<DemoBase
  demo={0}
  glass="smoke"
  actionBar={false}
  title="Home page demos | Targeteers Archery"
  description="Three home page directions for Targeteers Archery, for review."
>
  <div class="d-backdrop" slot="backdrop" aria-hidden="true">
    <div class="d-backdrop__layer">
      <Picture src={timber} alt="" formats={['avif', 'webp']} widths={[800, 1200, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="d-backdrop__scrim index-scrim"></div>
  </div>

  <div class="d-wrap index">
    <header class="index__head">
      <span class="index__logo">
        <Image src={logoRGB} alt="Targeteers Archery" widths={[320, 640]} sizes="220px" loading="eager" />
      </span>
      <h1>Three home pages. Pick the one Rob's customers will use.</h1>
      <p class="d-lead">Same facts, same photos, same copy. Only the shape changes.</p>
    </header>

    <ol class="index__cards">
      {demos.map((d, i) => (
        <li>
          <a class="index-card glass-smoke glass-lift" href={d.href}>
            <Image class="index-card__img" src={thumbs[i]} alt="" widths={[480, 800]} sizes="(max-width: 60rem) 92vw, 26rem" loading="lazy" />
            <span class="index-card__body">
              <span class="index-card__num">0{d.id} · {glassOf[i]}</span>
              <span class="index-card__name">{d.name}</span>
              <span class="index-card__line">{d.line}</span>
              <span class="d-link"><span>OPEN DEMO {d.id}</span><ArrowRightIcon size={16} /></span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</DemoBase>

<style>
  .index-scrim { background: linear-gradient(rgba(10, 26, 18, 0.55), rgba(10, 26, 18, 0.8)); }
  .d-backdrop :global(img) { filter: saturate(0.82) contrast(1.06) brightness(0.85); }

  .index { padding-block: clamp(3rem, 2rem + 6vw, 7rem) 8rem; }
  .index__head { display: grid; gap: var(--sp-5); justify-items: start; max-width: 46rem; }
  .index__logo { display: inline-block; background: #fff; border-radius: 14px; padding: 0.7rem 1.1rem; line-height: 0; }
  .index__logo :global(img) { width: 13rem; height: auto; }
  .index__head h1 { font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem); }

  .index__cards {
    list-style: none;
    margin: var(--sp-8) 0 0;
    padding: 0;
    display: grid;
    gap: var(--demo-gap);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }
  .index-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
  }
  .index-card :global(.index-card__img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .index-card__body { display: grid; gap: var(--sp-3); padding: var(--sp-5); align-content: start; flex: 1; }
  .index-card__num {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .index-card__name { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 600; line-height: 1.1; }
  .index-card__line { color: var(--ink-muted); font-size: var(--fs-small); max-width: 40ch; }
</style>
