---
/**
 * The home page: TRAILHEAD, the design Jon picked from the three demos.
 * The home page is the answer. A dashboard in clear glass with white ink over
 * Rob's own hero film: pick what you came for and the facts appear in place,
 * with no page load. The hours card on the right stays in view.
 * Signature arrow: the tab indicator. Pick a tile and an arrow flies from it
 * and sticks into the top-left edge of the detail panel.
 *
 * The task copy lives in src/data/home.ts. Hours, phone and address come from
 * src/data/business.ts. The film's rules: the poster is the LCP, the film only
 * loads at 48rem and up, with motion allowed and data saver off.
 */
import { Image, Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Base from '~/layouts/Base.astro';
import FactList from '~/components/FactList.astro';
import BrandArrow from '~/components/BrandArrow.astro';
import TaskIcon from '~/components/TaskIcon.astro';
import Map from '~/components/Map.astro';
import Form from '~/components/Form.astro';
import Field from '~/components/Field.astro';
import ArrowRightIcon from '~/components/icons/ArrowRightIcon.astro';
import PhoneIcon from '~/components/icons/PhoneIcon.astro';
import { tasks, imageFor } from '~/data/home';
import { business, brands, hours, hoursLabel, formatTime } from '~/data/business';
import { getPosts } from '~/utils/posts';

import poster from '~/assets/hero/hero-poster.jpg';
import counterMen from '~/assets/story/counter-three-men.jpg';

/* ---------------------------------------------------------- side cards */
const today = new Date();
today.setUTCHours(0, 0, 0, 0);
const events = (await getCollection('events'))
  .filter((e) => (e.data.end ?? e.data.start) >= today)
  .sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf())
  .slice(0, 3);
const leagues = (await getCollection('leagues')).sort((a, b) => a.data.order - b.data.order);
const latest = (await getPosts())[0];

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('~/assets/brands/*.{svg,png}', { eager: true });
const dealerMarks = brands
  .filter((b) => !b.url.startsWith('/'))
  .map((b) => {
    const hit = Object.entries(logoFiles).find(([p]) => p.split('/').pop()?.replace(/\.[^.]+$/, '') === b.slug);
    return { ...b, logo: hit?.[1].default };
  })
  .filter((b) => b.logo);

const fmtDay = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

/* -------------------------------------------------------------- hours */
const isoToday = ((new Date().getDay() + 6) % 7) + 1;
const weekFacts = hours.map((h) => ({ label: h.label, value: hoursLabel(h) }));
const hoursJson = JSON.stringify(
  hours.map((h) => ({ day: h.day, label: h.label, open: h.open ?? null, close: h.close ?? null })),
);
const todayRow = hours.find((h) => h.day === isoToday)!;
const initialState = todayRow.closed ? 'CLOSED TODAY' : 'OPEN TODAY';
const initialDetail = todayRow.closed ? 'Call for the week ahead.' : `${formatTime(todayRow.open!)} to ${formatTime(todayRow.close!)}`;
---
<Base
  title="Targeteers Archery Pro Shop & Indoor Range | Saddle Brook, NJ · Since 1957"
  description="North Jersey's family-owned archery pro shop and 11-lane indoor range in Saddle Brook. Bows, tuning, lessons, leagues and kids camp, since 1957."
  keywords={['archery pro shop North Jersey', 'archery pro shop NJ', 'indoor archery range NJ', 'bow shop Saddle Brook']}
  ogImage="/og/home.jpg"
  hoursHref="#today"
>
  <!-- ------------------------------------------------------------ backdrop -->
  <div class="d-backdrop th-backdrop" slot="backdrop" aria-hidden="true" data-th-backdrop>
    <div class="th-scene th-scene--film">
      <div class="d-backdrop__layer th-sharp">
        <Picture src={poster} alt="" formats={['avif', 'webp']} widths={[800, 1200, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
        <div class="th-video" data-th-video hidden></div>
      </div>
      <div class="d-backdrop__layer th-soft">
        <Image src={poster} alt="" widths={[640, 1000]} sizes="60vw" loading="lazy" />
      </div>
    </div>
    <div class="d-backdrop__scrim th-wash"></div>
  </div>

  <div class="d-wrap th">
    <!-- --------------------------------------------------------- greeting -->
    <header class="th-greet glass">
      <p class="th-greet__hello" data-greeting>Welcome in.</p>
      <h1>North Jersey's archery pro shop and indoor range.</h1>
    </header>

    <div class="th-bento">
      <!-- ------------------------------------------------------ task switcher
           One big glass card. The tiles and the open panel inside it are
           tinted panes, not glass, so there is never blur inside blur. -->
      <section class="th-switch glass" aria-labelledby="th-switch-title" data-th-switch>
        <h2 class="shot-head" id="th-switch-title">What are you here for?</h2>

        <div class="th-grid" data-th-grid>
          <nav class="th-tabs" aria-label="Pick what you came for" data-th-tabs>
            {tasks.map((t, i) => (
              <a class="th-tile pane" href={`#${t.id}`} id={`tab-${t.id}`} data-tab={t.id} data-index={String(i)}>
                <span class="th-tile__icon"><TaskIcon id={t.id} size={24} /></span>
                <span class="th-tile__text">
                  <span class="th-tile__tab">{t.tab}</span>
                  <span class="th-tile__line">{t.strip}</span>
                </span>
                <span class="th-tile__nock" aria-hidden="true"><ArrowRightIcon size={16} /></span>
              </a>
            ))}
          </nav>

          {tasks.map((t) => (
            <section class="th-panel pane" id={t.id} data-panel={t.id} aria-labelledby={`th-${t.id}-title`}>
              <div class="th-panel__copy">
                <span class="th-panel__nock" data-nock aria-hidden="true"></span>
                <p class="th-label th-panel__tab">{t.tab}</p>
                <h3 id={`th-${t.id}-title`}>{t.title}</h3>
                <p class="th-panel__body">{t.body}</p>
                <FactList facts={t.facts} size="md" />
                <div class="th-panel__actions">
                  <a class="d-btn d-btn--light" href={t.primary.href}>{t.primary.label}</a>
                  {t.secondary && <a class="d-link" href={t.secondary.href}><span>{t.secondary.label}</span><ArrowRightIcon size={16} /></a>}
                </div>
              </div>
              <Image class="th-panel__img" src={imageFor(t)} alt={t.imageAlt} widths={[420, 700, 1000]} sizes="(max-width: 48rem) 88vw, 22rem" loading="lazy" />
            </section>
          ))}

          <div class="th-flyer" data-th-flyer aria-hidden="true"><BrandArrow tone="light" /></div>
        </div>
      </section>

      <!-- --------------------------------------------- status: today at the shop -->
      <section class="th-status glass" id="today" aria-labelledby="th-status-title" data-th-status data-hours={hoursJson} data-reveal>
        <h2 class="shot-head th-label" id="th-status-title">TODAY AT THE SHOP</h2>
        <div class="th-status__state">
          <span class="th-ring" data-th-ring aria-hidden="true"></span>
          <p class="th-status__line">
            <span class="th-status__big" data-th-state>{initialState}</span>
            <span class="th-status__detail" data-th-detail>{initialDetail}</span>
          </p>
        </div>
        <a class="th-status__phone" href={business.phoneHref}>{business.phone}</a>
        <p class="th-status__addr">{business.address.street}, {business.address.city}, {business.address.region}</p>
        <div class="th-status__actions">
          <a class="d-btn d-btn--orange" href={business.phoneHref} data-primary>
            <PhoneIcon size={16} /><span>CALL THE SHOP</span>
          </a>
          <a class="d-btn d-btn--outline" href={business.directionsUrl} target="_blank" rel="noopener">GET DIRECTIONS</a>
        </div>
        <div class="th-status__week">
          <FactList facts={weekFacts} strong={isoToday - 1} hook="week" />
        </div>
      </section>
    </div>

    <!-- ------------------------------------------------------------ side cards -->
    <section class="th-side" aria-labelledby="th-side-title">
      <h2 class="visually-hidden shot-head" id="th-side-title">Around the shop</h2>

      <article class="th-mini glass" data-reveal>
        <h3 class="th-label">THIS WEEK</h3>
        {events.length ? (
          <dl class="th-mini__list">
            {events.map((e) => (
              <div><dt class="d-num">{fmtDay(e.data.start)}</dt><dd>{e.data.title}</dd></div>
            ))}
          </dl>
        ) : (
          <p class="th-mini__empty">Nothing special on the calendar. The range runs every open day.</p>
        )}
        <a class="d-link" href="/calendar/"><span>THE CALENDAR</span><ArrowRightIcon size={16} /></a>
      </article>

      <article class="th-mini glass" data-reveal data-stagger="1">
        <h3 class="th-label">LEAGUES FORMING</h3>
        <dl class="th-mini__list">
          {leagues.map((l) => (
            <div><dt>{l.data.name}</dt><dd>{l.data.night}, {l.data.time}</dd></div>
          ))}
        </dl>
        <a class="d-link" href="/leagues/"><span>LEAGUES</span><ArrowRightIcon size={16} /></a>
      </article>

      <article class="th-mini glass" data-reveal data-stagger="2">
        <h3 class="th-label">FROM THE COUNTER</h3>
        {latest && (
          <a class="th-mini__post" href={`/insights/${latest.id}/`}>
            <span class="th-mini__post-title">{latest.data.title}</span>
            <time class="d-num" datetime={latest.data.date.toISOString()}>{latest.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
          </a>
        )}
        <a class="d-link" href="/insights/"><span>ALL INSIGHTS</span><ArrowRightIcon size={16} /></a>
      </article>

      <article class="th-mini glass" data-reveal data-stagger="3">
        <h3 class="th-label">AUTHORIZED DEALER</h3>
        <ul class="th-marks">
          {dealerMarks.map((b) => (
            <li>
              <a href={b.url} target="_blank" rel="noopener" aria-label={`${b.name} (opens in a new tab)`}>
                <Image class="th-mark" data-slug={b.slug} src={b.logo!} alt={b.name} widths={[160, 320]} sizes="6rem" loading="lazy" />
              </a>
            </li>
          ))}
        </ul>
      </article>
    </section>

    <!-- ----------------------------------------------------------- family strip -->
    <aside class="th-family glass" aria-label="Our story" data-reveal>
      <Image src={counterMen} alt="Three men behind the Targeteers counter, archival photograph" widths={[160, 320]} sizes="7rem" loading="lazy" />
      <p>Three generations. One counter. Since 1957.</p>
      <a class="d-link" href="/about/"><span>OUR STORY</span><ArrowRightIcon size={16} /></a>
    </aside>

    <!-- ------------------------------------------------------------------ visit -->
    <section class="th-visit glass" id="visit" aria-labelledby="th-visit-title" data-reveal>
      <div class="th-visit__map"><Map /></div>
      <div class="th-visit__form">
        <h2 class="shot-head" id="th-visit-title">101 Route 46 West, Saddle Brook.</h2>
        <p class="d-body">Questions about a bow, a lesson or a party. Leave a note and we will call you back.</p>
        <Form action={business.formspree.contact} subject="Website message · targeteersarchery.com" name="contact-home" submitLabel="SEND IT">
          <Field label="Name" name="name" required autocomplete="name" />
          <Field label="Phone or email" name="contact" required autocomplete="email" />
          <Field label="Message" name="message" as="textarea" rows={4} required full />
        </Form>
      </div>
    </section>
  </div>

</Base>

<style>
  /* ----------------------------------------------------------- backdrop
     Rob's film at full colour, a soft-focus copy of the poster under the
     lower cards, and a navy wash that keeps white ink readable on snow. */
  .th-scene { position: absolute; inset: 0; }
  .th-scene .d-backdrop__layer { opacity: 1; }

  .th-video { position: absolute; inset: 0; opacity: 0; transition: opacity var(--dur-slower) var(--ease); }
  .th-video[data-playing] { opacity: 1; }
  .th-video :global(video) { width: 100%; height: 100%; object-fit: cover; }

  .th-soft :global(img) { filter: blur(14px) saturate(1.05); scale: 1.06; }
  .th-soft {
    -webkit-mask-image: linear-gradient(to bottom, transparent 40%, #000 72%);
    mask-image: linear-gradient(to bottom, transparent 40%, #000 72%);
  }
  .th-wash { background: var(--wash-film); }

  /* ------------------------------------------------------------- layout */
  .th { display: grid; gap: var(--panel-gap); }
  .th-label {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent-text);
  }
  .th-label.shot-head::before { width: 5.5rem; }

  /* ----------------------------------------------------------- greeting */
  .th-greet { padding: var(--sp-5) clamp(1.25rem, 1rem + 1.5vw, 2rem); display: grid; gap: var(--sp-2); }
  .th-greet__hello { margin: 0; font-family: var(--font-display); font-size: var(--fs-h4); font-weight: 600; color: var(--accent-text); }
  .th-greet h1 { font-size: clamp(1.75rem, 1.3rem + 1.9vw, 3rem); font-weight: 700; max-width: 26ch; }

  .th-bento { display: grid; gap: var(--panel-gap); align-items: start; }
  @media (min-width: 64rem) {
    .th-bento { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .th-switch { grid-column: 1 / span 8; }
    .th-status { grid-column: 9 / span 4; position: sticky; top: 7.5rem; }
  }

  /* -------------------------------------------------------------- status */
  .th-status { padding: clamp(1.25rem, 1rem + 1.2vw, 1.75rem); display: grid; gap: var(--sp-4); justify-items: start; }
  .th-status__state { display: flex; align-items: center; gap: var(--sp-4); }
  .th-ring {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 3px solid var(--ink);
    position: relative;
  }
  .th-ring[data-open] { border-color: var(--tgt-orange); background: radial-gradient(circle, var(--tgt-orange) 0 38%, transparent 40%); }
  .th-ring[data-open]::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 3px solid var(--tgt-orange);
    animation: th-pulse 2.4s var(--ease) infinite;
  }
  @keyframes th-pulse {
    from { scale: 1; opacity: 0.7; }
    to { scale: 1.7; opacity: 0; }
  }
  .th-status__line { margin: 0; display: grid; }
  .th-status__big { font-family: var(--font-display); font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.375rem); font-weight: 700; line-height: 1; letter-spacing: -0.01em; }
  .th-status__detail { margin-top: 0.3rem; font-weight: 600; color: var(--ink-muted); }
  .th-status__phone {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
  }
  .th-status__phone:hover { color: var(--accent-text); }
  .th-status__addr { margin: calc(var(--sp-2) * -1) 0 0; color: var(--ink-muted); font-size: var(--fs-small); }
  .th-status__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .th-status__week { width: 100%; padding-top: var(--sp-3); border-top: 1px solid var(--hair); }

  /* -------------------------------------------------------------- switcher */
  .th-switch {
    display: grid;
    gap: var(--sp-4);
    min-width: 0;
    padding: clamp(0.875rem, 0.6rem + 1vw, 1.5rem);
    border-radius: 28px;
  }
  .th-switch > h2 {
    font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2.25rem);
    font-weight: 700;
    padding: var(--sp-2) var(--sp-2) 0;
  }

  .th-grid {
    position: relative;
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 48rem) { .th-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  /* The tiles and the panels share one grid, so on a phone the open panel can
     drop in directly under the row of the tile that opened it. */
  .th-tabs { display: contents; }

  .th-tile {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    min-height: 5rem;
    border-radius: 18px;
    text-decoration: none;
    color: var(--ink);
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .th-tile:hover { transform: translateY(-2px); border-color: rgba(255, 255, 255, 0.5); }
  .th-tile__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: var(--accent-text);
  }
  .th-tile__text { display: grid; gap: 0.15rem; min-width: 0; }
  .th-tile__tab { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; }
  .th-tile__line { font-size: 0.8125rem; line-height: 1.35; color: var(--ink-muted); }
  .th-tile__nock { color: var(--ink-faint); transition: translate var(--dur-fast) var(--ease); }
  .th-tile:hover .th-tile__nock { translate: 8px 0; }
  .th-tile[aria-selected='true'] { background: var(--tgt-white); color: var(--tgt-navy); border-color: var(--tgt-white); }
  .th-tile[aria-selected='true'] .th-tile__line,
  .th-tile[aria-selected='true'] .th-tile__nock { color: rgba(0, 24, 64, 0.8); }
  .th-tile[aria-selected='true'] .th-tile__icon { background: rgba(0, 24, 64, 0.08); color: var(--tgt-orange-ink); }
  @media (max-width: 47.99rem) {
    .th-tile { grid-template-columns: 1fr; align-content: start; gap: var(--sp-2); }
    .th-tile__nock { display: none; }
  }

  /* Panels: all six are in the HTML. Without script they render stacked. */
  .th-panel {
    grid-column: 1 / -1;
    order: 100;
    display: grid;
    gap: var(--sp-5);
    padding: clamp(1.25rem, 1rem + 1.4vw, 2rem);
    border-radius: 20px;
    scroll-margin-top: 7.5rem;
  }
  .th-panel[hidden] { display: none; }
  @media (min-width: 48rem) {
    .th-panel { grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.75fr); align-items: start; }
  }
  .th-panel__copy { display: grid; gap: var(--sp-4); justify-items: start; }
  /* Where the flying arrow comes to rest: the panel's top-left corner, flat,
     like a heading arrow. Reserved space, so it never lands on a tile. */
  .th-panel__nock { display: block; width: 6.5rem; aspect-ratio: 300 / 34; margin-bottom: calc(var(--sp-4) * -0.5); }
  .th-panel h3 { font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem); font-weight: 700; }
  .th-panel__body { margin: 0; color: var(--ink-muted); max-width: 60ch; }
  .th-panel__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-3) var(--sp-5); padding-top: var(--sp-2); }
  .th-panel :global(.th-panel__img) { width: 100%; height: 100%; max-height: 24rem; object-fit: cover; border-radius: 20px; }
  @media (max-width: 47.99rem) {
    .th-panel :global(.th-panel__img) { order: -1; aspect-ratio: 16 / 10; }
  }

  /* Phone: the open panel sits under its own row. JS sets data-row. */
  @media (max-width: 47.99rem) {
    .th-tile[data-index='0'] { order: 0; }
    .th-tile[data-index='1'] { order: 1; }
    .th-tile[data-index='2'] { order: 3; }
    .th-tile[data-index='3'] { order: 4; }
    .th-tile[data-index='4'] { order: 6; }
    .th-tile[data-index='5'] { order: 7; }
    .th-panel[data-row='0'] { order: 2; }
    .th-panel[data-row='1'] { order: 5; }
    .th-panel[data-row='2'] { order: 8; }
  }

  /* The flying arrow. Positioned by script in the grid's own coordinates. */
  .th-flyer {
    position: absolute;
    left: 0;
    top: 0;
    width: 6.5rem;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    transform-origin: 100% 50%;
  }
  .th-flyer[data-placed] { opacity: 1; }

  /* ------------------------------------------------------------ side cards */
  .th-side {
    display: grid;
    gap: var(--panel-gap);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .th-mini { padding: var(--sp-5); display: flex; flex-direction: column; gap: var(--sp-4); align-items: flex-start; }
  .th-mini .d-link { margin-top: auto; }
  .th-mini__list { margin: 0; width: 100%; }
  .th-mini__list div {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--hair);
    font-size: var(--fs-small);
  }
  .th-mini__list div:last-child { border-bottom: 0; }
  .th-mini__list dt { font-weight: 600; }
  .th-mini__list dd { margin: 0; text-align: right; color: var(--ink-muted); }
  .th-mini__empty { margin: 0; font-size: var(--fs-small); color: var(--ink-muted); }
  .th-mini__post { display: grid; gap: var(--sp-2); text-decoration: none; color: var(--ink); }
  .th-mini__post-title { font-family: var(--font-display); font-size: var(--fs-h4); font-weight: 700; line-height: 1.25; }
  .th-mini__post time { font-size: var(--fs-small); color: var(--ink-muted); }
  .th-mini__post:hover .th-mini__post-title { text-decoration: underline; text-underline-offset: 0.2em; }

  .th-marks {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-2) var(--sp-4);
  }
  .th-marks a { display: grid; place-items: center; min-height: 3rem; }
  .th-marks :global(.th-mark) {
    width: auto;
    max-width: 100%;
    max-height: 2rem;
    object-fit: contain;
    /* Dealer marks in white, one colour so the grid reads as a grid. */
    filter: brightness(0) invert(1);
  }
  /* The two badge logos keep their own colours. */
  .th-marks :global(.th-mark:is([data-slug='hoyt'], [data-slug='tenpoint'])) { filter: none; }

  /* ---------------------------------------------------------- family strip */
  .th-family {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4) var(--sp-5);
    padding: var(--sp-4) var(--sp-5);
  }
  .th-family :global(img) { width: 5.5rem; height: 4rem; object-fit: cover; border-radius: 12px; }
  .th-family p { margin: 0; flex: 1 1 16rem; font-family: var(--font-display); font-size: var(--fs-h4); font-weight: 700; }

  /* ----------------------------------------------------------------- visit */
  .th-visit { display: grid; gap: var(--sp-6); padding: clamp(1.25rem, 1rem + 1.4vw, 2rem); }
  @media (min-width: 60rem) { .th-visit { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; } }
  .th-visit__form { display: grid; gap: var(--sp-4); }
  .th-visit__form h2 { font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem); font-weight: 700; }
  .th-visit__form .d-body { margin: 0; }
</style>

<script>
  import { gsap } from 'gsap';

  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const NY = 'America/New_York';
  const ORDER = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

  type Row = { day: number; label: string; open: string | null; close: string | null };

  function fmt(t: string) {
    const [h, m] = t.split(':').map(Number);
    const suffix = h >= 12 ? 'pm' : 'am';
    const hour = h % 12 === 0 ? 12 : h % 12;
    return m ? `${hour}:${String(m).padStart(2, '0')} ${suffix}` : `${hour} ${suffix}`;
  }
  const mins = (t: string) => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };

  /* ------------------------------------------------ greeting, NJ time */
  function greet() {
    const el = document.querySelector('[data-greeting]');
    if (!el) return;
    const hour = Number(new Intl.DateTimeFormat('en-US', { timeZone: NY, hour: 'numeric', hour12: false }).format(new Date())) % 24;
    el.textContent = hour < 12 ? 'Good morning.' : hour < 17 ? 'Good afternoon.' : 'Good evening.';
  }

  /* ---------------------------------------- status: open now or closed */
  function status() {
    const card = document.querySelector<HTMLElement>('[data-th-status]');
    if (!card) return;
    const rows = JSON.parse(card.dataset.hours ?? '[]') as Row[];
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: NY, weekday: 'short', hour: 'numeric', minute: 'numeric', hour12: false,
    }).formatToParts(new Date());
    const wd = parts.find((p) => p.type === 'weekday')?.value ?? 'Mon';
    const now = (Number(parts.find((p) => p.type === 'hour')?.value ?? 0) % 24) * 60 + Number(parts.find((p) => p.type === 'minute')?.value ?? 0);
    const iso = ORDER.indexOf(wd) + 1;
    const today = rows.find((r) => r.day === iso);

    const state = card.querySelector('[data-th-state]');
    const detail = card.querySelector('[data-th-detail]');
    const ring = card.querySelector('[data-th-ring]');
    if (!today || !state || !detail || !ring) return;

    const open = !!(today.open && today.close && now >= mins(today.open) && now < mins(today.close));
    ring.toggleAttribute('data-open', open);
    if (open) {
      state.textContent = 'OPEN NOW';
      detail.textContent = `until ${fmt(today.close!)}`;
    } else {
      state.textContent = 'CLOSED';
      let next = '';
      if (today.open && now < mins(today.open)) next = `Opens today at ${fmt(today.open)}`;
      else {
        for (let i = 1; i <= 7; i++) {
          const r = rows.find((x) => x.day === ((iso - 1 + i) % 7) + 1);
          if (r?.open) { next = `Opens ${i === 1 ? 'tomorrow' : r.label} at ${fmt(r.open)}`; break; }
        }
      }
      detail.textContent = next;
    }

    // Bold today's row in the week list.
    card.querySelectorAll('[data-fact-list="week"] > div').forEach((row, i) => {
      row.toggleAttribute('data-strong', i === iso - 1);
    });
  }

  /* --------------------------------- the film, only where it is welcome */
  function film() {
    const root = document.querySelector<HTMLElement>('[data-th-backdrop]');
    if (!root) return;
    const holder = root.querySelector<HTMLElement>('[data-th-video]');
    if (!holder || holder.childElementCount) return;
    const wide = matchMedia('(min-width: 48rem)').matches;
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const thrifty = conn?.saveData === true || /^(slow-2g|2g)$/.test(conn?.effectiveType ?? '');
    if (reduced() || !wide || thrifty) return;

    const v = document.createElement('video');
    v.autoplay = true; v.muted = true; v.defaultMuted = true; v.loop = true; v.playsInline = true;
    v.preload = 'metadata';
    v.setAttribute('aria-hidden', 'true');
    v.tabIndex = -1;
    const big = matchMedia('(min-width: 64rem)').matches;
    if (big) {
      const webm = document.createElement('source');
      webm.src = '/video/hero.webm'; webm.type = 'video/webm';
      v.append(webm);
    }
    const mp4 = document.createElement('source');
    mp4.src = big ? '/video/hero.mp4' : '/video/hero-sm.mp4'; mp4.type = 'video/mp4';
    v.append(mp4);
    v.addEventListener('canplay', () => { holder.hidden = false; holder.setAttribute('data-playing', ''); }, { once: true });
    holder.append(v);
    v.play().catch(() => holder.remove());
  }

  /* ------------------------------------------------------ the switcher
     Real ARIA tabs, layered on top of plain links and stacked panels. */
  function switcher() {
    const grid = document.querySelector<HTMLElement>('[data-th-grid]');
    if (!grid || grid.dataset.wired) return;
    grid.dataset.wired = '';
    const tablist = grid.querySelector<HTMLElement>('[data-th-tabs]')!;
    const tabs = [...grid.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const panels = [...grid.querySelectorAll<HTMLElement>('[data-panel]')];
    const flyer = grid.querySelector<HTMLElement>('[data-th-flyer]');
    const phone = matchMedia('(max-width: 47.99rem)');

    tablist.setAttribute('role', 'tablist');
    tablist.removeAttribute('aria-label');
    tablist.setAttribute('aria-labelledby', 'th-switch-title');
    tabs.forEach((tab) => {
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', tab.dataset.tab!);
    });
    panels.forEach((p) => {
      p.setAttribute('role', 'tabpanel');
      p.setAttribute('aria-labelledby', `tab-${p.dataset.panel}`);
      p.setAttribute('tabindex', '0');
    });

    let current = '';

    /* The arrow leaves the tile pointing at the panel, then levels out and
       sticks flat in the panel's top-left corner with the shudder. 450ms. */
    const fly = (tab: HTMLElement, panel: HTMLElement, animate: boolean) => {
      const nock = panel.querySelector<HTMLElement>('[data-nock]');
      if (!flyer || !nock) return;
      const g = grid.getBoundingClientRect();
      const t = tab.getBoundingClientRect();
      const n = nock.getBoundingClientRect();
      const w = flyer.offsetWidth;
      const h = flyer.offsetHeight;
      const endLeft = n.left - g.left;
      const endTop = n.top - g.top + (n.height - h) / 2;
      const startLeft = t.left - g.left + t.width / 2 - w;
      const startTop = t.top - g.top + t.height / 2 - h / 2;
      const angle = (Math.atan2(endTop - startTop, endLeft - startLeft) * 180) / Math.PI;
      gsap.killTweensOf(flyer);
      flyer.setAttribute('data-placed', '');
      if (!animate || reduced()) {
        gsap.set(flyer, { x: endLeft, y: endTop, rotate: 0 });
        return;
      }
      gsap.timeline()
        .fromTo(flyer,
          { x: startLeft, y: startTop, rotate: angle, opacity: 0.4 },
          { x: endLeft, y: endTop, rotate: 0, opacity: 1, duration: 0.45, ease: 'power3.out' })
        .to(flyer, {
          keyframes: [
            { rotate: -2, duration: 0.08 },
            { rotate: 1.2, duration: 0.1 },
            { rotate: -0.5, duration: 0.12 },
            { rotate: 0, duration: 0.14 },
          ],
          ease: 'sine.inOut',
        });
    };

    /* New content eases in rather than snapping: the copy rises and fades
       line by line, the photo settles from a touch larger. About 1s. */
    const reveal = (panel: HTMLElement) => {
      const lines = panel.querySelectorAll<HTMLElement>('.th-panel__copy > :not([data-nock])');
      const img = panel.querySelector<HTMLElement>('.th-panel__img');
      const all = [...panels.flatMap((p) => [...p.querySelectorAll<HTMLElement>('.th-panel__copy > *, .th-panel__img')])];
      gsap.killTweensOf(all);
      gsap.set(all, { clearProps: 'opacity,transform' });
      if (reduced()) return;
      gsap.fromTo(lines,
        { opacity: 0, y: 16 },
        { opacity: 1, y: 0, duration: 0.7, stagger: 0.08, ease: 'sine.out', clearProps: 'opacity,transform' });
      if (img) gsap.fromTo(img,
        { opacity: 0, scale: 1.04 },
        { opacity: 1, scale: 1, duration: 0.9, ease: 'sine.out', clearProps: 'opacity,transform' });
    };

    const select = (id: string, opts: { focus?: boolean; animate?: boolean; scroll?: boolean } = {}) => {
      const index = tabs.findIndex((t) => t.dataset.tab === id);
      if (index < 0) return;
      current = id;
      tabs.forEach((t, i) => {
        const on = i === index;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => {
        const on = p.dataset.panel === id;
        p.hidden = !on;
        if (on) p.dataset.row = String(Math.floor(index / 2));
      });
      const tab = tabs[index];
      const panel = panels.find((p) => p.dataset.panel === id)!;
      if (opts.focus) tab.focus();
      if (opts.animate ?? true) reveal(panel);
      requestAnimationFrame(() => {
        fly(tab, panel, opts.animate ?? true);
        if (opts.scroll && phone.matches) panel.scrollIntoView({ behavior: reduced() ? 'auto' : 'smooth', block: 'nearest' });
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        // motion.ts hands every #hash click to Lenis as a scroll. A tab is not
        // a jump, so the click stops here.
        e.stopPropagation();
        select(tab.dataset.tab!, { scroll: true });
        history.replaceState(null, '', `#${tab.dataset.tab}`);
      });
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = {
          ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: tabs.length - 1,
        };
        if (!(e.key in keys)) return;
        e.preventDefault();
        const next = (keys[e.key] + tabs.length) % tabs.length;
        select(tabs[next].dataset.tab!, { focus: true });
      });
    });

    const fromHash = () => {
      const id = location.hash.slice(1);
      if (tabs.some((t) => t.dataset.tab === id)) {
        select(id, { animate: false });
        grid.closest('section')?.scrollIntoView({ block: 'start' });
        return true;
      }
      return false;
    };
    if (!fromHash()) select('shoot', { animate: false });
    addEventListener('hashchange', fromHash);
    // Keep the stuck arrow on its panel when the layout reflows.
    addEventListener('resize', () => {
      const tab = tabs.find((t) => t.dataset.tab === current);
      const panel = panels.find((p) => p.dataset.panel === current);
      if (tab && panel) fly(tab, panel, false);
    }, { passive: true });
  }

  function init() {
    if (!document.querySelector('[data-th-backdrop]')) return;
    greet();
    status();
    film();
    switcher();
  }
  document.addEventListener('astro:page-load', init);
</script>
