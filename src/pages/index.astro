---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import HeroFilm from '~/components/hero/HeroFilm.astro';
import Milestones from '~/components/Milestones.astro';
import Section from '~/components/Section.astro';
import SectionHead from '~/components/SectionHead.astro';
import Card from '~/components/Card.astro';
import Reveal from '~/components/Reveal.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Button from '~/components/Button.astro';
import ArrowLink from '~/components/ArrowLink.astro';
import DealerRow from '~/components/DealerRow.astro';
import PostCard from '~/components/PostCard.astro';
import HoursTable from '~/components/HoursTable.astro';
import Newsletter from '~/components/Newsletter.astro';
import Map from '~/components/Map.astro';
import OpenNowPill from '~/components/OpenNowPill.astro';
import TargetIcon from '~/components/icons/TargetIcon.astro';
import { getPosts } from '~/utils/posts';
import { business, addressLine } from '~/data/business';

import wallOfBows from '~/assets/shop/wall-of-bows.jpg';
import showroom from '~/assets/shop/showroom-01.jpg';
import benchImg from '~/assets/story/rob-at-the-bench.jpg';
import lessonsImg from '~/assets/range/full-draw.jpg';
import rangeImg from '~/assets/range/lanes-05.jpg';
import counterMen from '~/assets/story/counter-three-men.jpg';
import campImg from '~/assets/kids/camp-wide.jpg';
import groupsImg from '~/assets/groups/seminar-01.jpg';
import trophyImg from '~/assets/trophy/mount-04.jpg';

const posts = (await getPosts()).slice(0, 3);

const milestones = [
  { value: '1957', label: 'A bow shop opens on Route 46 in Saddle Brook.' },
  { value: '3', label: 'Generations of one family behind the same counter.' },
  { value: '11', label: 'Indoor lanes, air conditioned, out to 27 yards.' },
  { value: '130', label: 'Kids come through camp every summer.' },
  { value: '69', label: 'Years of doing it the same way. On purpose.' },
];
---
<Base
  title="Targeteers Archery Pro Shop & Indoor Range | Saddle Brook, NJ · Since 1957"
  description="North Jersey's family-owned archery pro shop and 11-lane indoor range in Saddle Brook. Bows, tuning, lessons, leagues and kids camp, since 1957."
  keywords={['archery pro shop North Jersey', 'archery pro shop NJ', 'indoor archery range NJ', 'bow shop Saddle Brook']}
  ogImage="/og/home.jpg"
  overHero
>
  <HeroFilm />

  <Milestones
    id="since"
    title="Sixty-nine years on Route 46."
    items={milestones}
  />

  <!-- ------------------------------------------------------ what we do -->
  <Section tone="cream" id="what-we-do">
    <SectionHead
      eyebrow="What we do"
      title="A full pro shop, a real bench, and a range out back."
      lead="Four things, done properly, in one building on Route 46."
    />
    <div class="grid-4">
      <Reveal delay={0}>
        <Card
          href="/pro-shop/"
          eyebrow="Pro Shop"
          title="Hundreds of bows on the wall"
          body="Compounds, crossbows, recurves, arrows and everything that hangs off them. Draw one before you decide."
          image={showroom}
          imageAlt="Accessories and broadheads on the pro shop wall"
        />
      </Reveal>
      <Reveal delay={1}>
        <Card
          href="/services/"
          eyebrow="Tuning & Repairs"
          title="Looked over twice, every time"
          body="Paper tuning, custom strings and arrows, repairs. The rule about the second look started in 1957."
          image={benchImg}
          imageAlt="Working on a bow at the service bench"
        />
      </Reveal>
      <Reveal delay={2}>
        <Card
          href="/lessons/"
          eyebrow="Lessons & Camp"
          title="Never held a bow? Good."
          body="Equipment included, certified instruction, from age seven. Half an hour is enough to find out."
          image={lessonsImg}
          imageAlt="An archer at full draw"
        />
      </Reveal>
      <Reveal delay={3}>
        <Card
          href="/range/"
          eyebrow="Range & Leagues"
          title="Eleven lanes, 27 yards"
          body="Indoor, air conditioned, open to the public. Adult and youth leagues run all season."
          image={rangeImg}
          imageAlt="Archers on the line at the indoor range"
        />
      </Reveal>
    </div>
  </Section>

  <!-- ------------------------------------------------------- pro shop band -->
  <section class="shop-band tone-pine" data-parallax-scope aria-labelledby="shop-band-title">
    <div class="shop-band__media" data-speed="0.72">
      <Image src={wallOfBows} alt="" widths={[560, 800, 1200, 1600, 1920]} sizes="100vw" loading="lazy" aria-hidden="true" />
    </div>
    <div class="shop-band__scrim" aria-hidden="true"></div>
    <div class="wrap shop-band__inner">
      <Reveal>
        <Eyebrow>The pro shop</Eyebrow>
        <h2 id="shop-band-title">100s of bows on the wall.<br />Zero pressure.</h2>
        <p class="lead">
          Nobody here works on commission and nobody is going to talk you into the wrong bow. Tell
          us what you actually want to do with it and we will put two or three in your hands.
        </p>
        <div class="shop-band__actions">
          <Button href="/pro-shop/" variant="primary">See the pro shop</Button>
          <Button href="/services/bow-tuning/" variant="ghost">How we tune a bow</Button>
        </div>
      </Reveal>
      <Reveal delay={2}><DealerRow /></Reveal>
    </div>
  </section>

  <!-- ---------------------------------------------------------- the family -->
  <Section tone="linen" id="family">
    <div class="story">
      <Reveal class="story__media">
        <figure class="story__frame">
          <Image src={counterMen} alt="Three men behind the Targeteers counter, archival photograph"
            widths={[560, 900]} sizes="(max-width: 60rem) 90vw, 30rem" loading="lazy" />
          <figcaption>The photograph on the office wall. Route 46, Saddle Brook.</figcaption>
        </figure>
      </Reveal>
      <div class="story__copy flow">
        <Reveal><Eyebrow>The family story</Eyebrow></Reveal>
        <Reveal delay={1}><h2>Three generations. One counter.</h2></Reveal>
        <Reveal delay={2}>
          <p>
            A bow shop opened on Route 46 in 1957. Rob bought it from his father in the nineties,
            after he had already been in the trade for twenty years. 2020 marked his fiftieth.
          </p>
        </Reveal>
        <Reveal delay={3}>
          <p>
            Almost everything about the equipment has changed since that photograph. Cams, carbon,
            crossbows, sights that would look like science fiction to the men behind that counter.
          </p>
        </Reveal>
        <Reveal delay={4}>
          <p>
            What has not changed is the bench, and the rule that no bow leaves this shop without
            being looked over twice. Rob did not invent that rule. He inherited it.
          </p>
        </Reveal>
        <Reveal delay={5}><ArrowLink href="/about/">Read our story</ArrowLink></Reveal>
      </div>
    </div>
  </Section>

  <!-- ------------------------------------------------------- kids + groups -->
  <section class="split" aria-label="Kids camp and group events">
    <article class="split__panel">
      <Image src={campImg} alt="Kids on the line at summer camp" widths={[480, 760, 1200, 1800]}
        sizes="(max-width: 48rem) 100vw, 50vw" loading="lazy" />
      <div class="split__scrim" aria-hidden="true"></div>
      <div class="split__copy">
        <Eyebrow>Kids Archery Camp</Eyebrow>
        <h2>130 kids a summer. Every one of them hits something.</h2>
        <p>From age seven. Equipment provided, certified instruction, safety first and fun a very close second.</p>
        <Button href="/kids/" variant="primary">Kids camp &amp; youth</Button>
      </div>
    </article>
    <article class="split__panel">
      <Image src={groupsImg} alt="A group evening on the range" widths={[480, 760, 1200, 1800]}
        sizes="(max-width: 48rem) 100vw, 50vw" loading="lazy" />
      <div class="split__scrim" aria-hidden="true"></div>
      <div class="split__copy">
        <Eyebrow>Groups &amp; Events</Eyebrow>
        <h2>Troops, teams, parties and speaker nights.</h2>
        <p>Equipment, range time, instruction and targets. We have put a lot of people on this line who had never held a bow.</p>
        <Button href="/groups/" variant="primary">Plan a group</Button>
      </div>
    </article>
  </section>

  <!-- --------------------------------------------------------- trophy room -->
  <section class="trophy tone-bark" data-parallax-scope aria-labelledby="trophy-title">
    <div class="trophy__media" data-speed="0.78">
      <Image src={trophyImg} alt="" widths={[560, 800, 1200, 1600, 1920]} sizes="100vw" loading="lazy" aria-hidden="true" />
    </div>
    <div class="trophy__scrim" aria-hidden="true"></div>
    <div class="wrap trophy__inner">
      <Reveal>
        <Eyebrow>The Trophy Room</Eyebrow>
        <h2 id="trophy-title">Two hundred mounts. One polar bear.<br />Come see for yourself.</h2>
        <ArrowLink href="/trophy-room/">Walk the room</ArrowLink>
      </Reveal>
    </div>
  </section>

  <!-- ------------------------------------------------------------ insights -->
  <Section tone="cream" id="insights">
    <SectionHead
      eyebrow="Insights"
      title="Notes from behind the counter."
      lead="Tuning, gear, hunting season and the occasional bit of family history."
    >
      <p class="section-head__link"><ArrowLink href="/insights/">All insights</ArrowLink></p>
    </SectionHead>
    <div class="grid-3">
      {posts.map((post, i) => <Reveal delay={i}><PostCard post={post} /></Reveal>)}
    </div>
  </Section>

  <!-- --------------------------------------------------------------- visit -->
  <Section tone="linen" id="visit">
    <div class="visit">
      <div class="visit__copy">
        <Reveal><Eyebrow>Visit</Eyebrow></Reveal>
        <Reveal delay={1}><h2>101 Route 46 West, Saddle Brook.</h2></Reveal>
        <Reveal delay={2}>
          <p class="lead">
            Fifteen minutes from most of Bergen County, with ample parking and a Sasquatch by the
            door. He does not say much.
          </p>
        </Reveal>
        <Reveal delay={3}>
          <div class="visit__contact">
            <a class="visit__phone" href={business.phoneHref}>{business.phone}</a>
            <p class="visit__address">{addressLine}</p>
            <OpenNowPill />
          </div>
        </Reveal>
        <Reveal delay={4}>
          <div class="visit__actions">
            <Button href={business.directionsUrl} variant="primary" external>Get directions</Button>
            <Button href="/contact/" variant="ghost">Contact us</Button>
          </div>
        </Reveal>
        <Reveal delay={5}>
          <div class="visit__hours">
            <h3 class="visit__hours-title"><TargetIcon size={16} /> Hours</h3>
            <HoursTable />
          </div>
        </Reveal>
      </div>
      <div class="visit__side">
        <Reveal><Map /></Reveal>
        <Reveal delay={2}><Newsletter /></Reveal>
      </div>
    </div>
  </Section>
</Base>

<style>
  .grid-4, .grid-3 {
    display: grid;
    gap: clamp(1rem, 0.4rem + 1.6vw, 1.75rem);
  }
  .grid-4 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .grid-3 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }
  .grid-4 > :global(*), .grid-3 > :global(*) { display: flex; }
  .grid-4 > :global(*) > :global(*), .grid-3 > :global(*) > :global(*) { width: 100%; }
  .section-head__link { margin-top: var(--sp-5); }

  /* ------------------------------------------------------------ shop band */
  .shop-band {
    position: relative;
    background: var(--pine-900);
    color: var(--cream-50);
    padding-block: calc(var(--section-y) * 1.15);
    overflow: hidden;
    isolation: isolate;
  }
  .shop-band__media { position: absolute; inset: -10% 0; z-index: 0; }
  .shop-band__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .shop-band__scrim {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(105deg, rgba(20, 38, 27, 0.96) 0%, rgba(20, 38, 27, 0.85) 42%, rgba(20, 38, 27, 0.5) 100%);
  }
  .shop-band__inner { position: relative; z-index: 2; display: grid; gap: var(--sp-8); min-width: 0; }
  .shop-band__inner > :global(*) { min-width: 0; }
  .shop-band__inner h2 { max-width: 16ch; }
  .shop-band__inner .lead { margin-top: var(--sp-5); color: rgba(248, 245, 238, 0.82); }
  .shop-band__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-6); }

  /* ----------------------------------------------------------- family story */
  .story { display: grid; gap: var(--sp-7); align-items: center; }
  @media (min-width: 60rem) {
    .story { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr); gap: var(--sp-9); }
    .story__media { position: sticky; top: calc(var(--nav-h) + 3rem); }
  }
  .story__frame {
    margin: 0;
    background: var(--cream-50);
    padding: clamp(0.9rem, 0.4rem + 1.6vw, 1.75rem);
    border: 1px solid var(--parchment);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .story__frame :global(img) { width: 100%; height: auto; }
  .story__frame figcaption {
    margin-top: var(--sp-4);
    font-size: 0.8125rem;
    color: var(--stone-400);
    text-align: center;
  }
  .story__copy p { max-width: 46ch; }
  .story__copy p + p, .story__copy h2 { margin-top: var(--sp-4); }
  .story__copy :global(.arrow-link) { margin-top: var(--sp-5); }

  /* ----------------------------------------------------------------- split */
  .split { display: grid; }
  @media (min-width: 48rem) { .split { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .split__panel {
    --ember: var(--ember-bright);
    position: relative;
    min-height: 34rem;
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
    --accent: var(--ember-bright);
  }
  .split__panel :global(img) {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%; object-fit: cover;
    transition: scale var(--dur-slower) var(--ease);
  }
  .split__panel:hover :global(img) { scale: 1.04; }
  .split__scrim {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to top, rgba(20, 38, 27, 0.94) 8%, rgba(20, 38, 27, 0.6) 42%, rgba(20, 38, 27, 0.18) 100%);
  }
  .split__copy {
    position: relative; z-index: 2;
    padding: var(--gutter);
    color: var(--cream-50);
    max-width: 32rem;
  }
  .split__copy h2 { color: var(--cream-50); font-size: var(--fs-h3); }
  .split__copy p { margin: var(--sp-4) 0 var(--sp-5); color: rgba(248, 245, 238, 0.82); font-size: var(--fs-small); line-height: 1.65; }

  /* ---------------------------------------------------------- trophy room */
  .trophy {
    position: relative;
    min-height: 26rem;
    display: grid;
    align-items: center;
    padding-block: var(--section-y);
    overflow: hidden;
    isolation: isolate;
    color: var(--cream-50);
    --ember: var(--ember-bright);
    --accent: var(--ember-bright);
  }
  .trophy__media { position: absolute; inset: -10% 0; z-index: 0; }
  .trophy__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .trophy__scrim {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to right, rgba(30, 23, 17, 0.93) 0%, rgba(30, 23, 17, 0.72) 55%, rgba(30, 23, 17, 0.45) 100%);
  }
  .trophy__inner { position: relative; z-index: 2; }
  .trophy__inner h2 { color: var(--cream-50); max-width: 20ch; margin-bottom: var(--sp-5); }

  /* ----------------------------------------------------------------- visit */
  .visit { display: grid; gap: var(--sp-8); }
  @media (min-width: 60rem) { .visit { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: var(--sp-9); } }
  .visit__contact { margin-top: var(--sp-6); display: grid; gap: var(--sp-3); justify-items: start; }
  .visit__phone {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    text-decoration: none;
    color: var(--bark-700);
    transition: color var(--dur-fast) var(--ease);
  }
  .visit__phone:hover { color: var(--ember); }
  .visit__address { margin: 0; font-size: var(--fs-small); }
  .visit__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-6); }
  .visit__hours { margin-top: var(--sp-7); max-width: 26rem; }
  .visit__hours-title {
    display: flex; align-items: center; gap: 0.55em;
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--ember);
    margin-bottom: var(--sp-3);
  }
  .visit__side { display: grid; gap: var(--sp-6); align-content: start; }
</style>
