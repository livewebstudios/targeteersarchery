---
/**
 * The v2 chooser. On this branch / and /v2/ render the same component, so the
 * Trailhead home page cannot be reached.
 */
import V2Base from '~/layouts/V2Base.astro';
import V2Chooser from '~/components/v2/V2Chooser.astro';
---
<V2Base demo={0} theme="chooser" title="Three home pages. Pick one. | Targeteers Archery" description="Three home page designs for Targeteers Archery Pro Shop. A private review page.">
  <V2Chooser />
</V2Base>

<style is:global>
  .v2--chooser { background: #fff; }
</style>
