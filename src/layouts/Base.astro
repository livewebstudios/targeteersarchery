---
import '@fontsource-variable/familjen-grotesk';
import '@fontsource-variable/instrument-sans';
import '~/styles/tokens.css';
import '~/styles/global.css';

import { ClientRouter } from 'astro:transitions';
import SiteNav from '~/components/nav/SiteNav.astro';
import ActionBar from '~/components/nav/ActionBar.astro';
import Footer from '~/components/Footer.astro';
import Backdrop from '~/components/Backdrop.astro';
import SectionLinks from '~/components/nav/SectionLinks.astro';
import Analytics from '~/components/Analytics.astro';
import Seo from '~/components/seo/Seo.astro';
import type { SeoProps } from '~/components/seo/Seo.astro';
import JsonLd from '~/components/seo/JsonLd.astro';
import { localBusinessSchema, breadcrumbSchema } from '~/components/seo/localBusiness';
import { sceneFor, type Scene } from '~/data/scenes';
import SiteGate from '~/components/SiteGate.astro';

export interface Props extends SeoProps {
  bodyClass?: string;
  breadcrumbs?: { name: string; path: string }[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** The landscape behind the glass. Picked from the URL when left out. */
  scene?: Scene;
  /** Where the phone action bar's HOURS button jumps. The footer by default. */
  hoursHref?: string;
}

const {
  bodyClass = '',
  breadcrumbs,
  schema,
  scene = sceneFor(Astro.url.pathname),
  hoursHref,
  ...seo
} = Astro.props;

const siteUrl = Astro.site!.href;
const graph: Record<string, unknown>[] = [localBusinessSchema(siteUrl)];
if (breadcrumbs?.length) graph.push(breadcrumbSchema(siteUrl, breadcrumbs));
if (schema) graph.push(...(Array.isArray(schema) ? schema : [schema]));

const bodyClasses = ['has-actionbar', bodyClass].filter(Boolean).join(' ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#001840" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Targeteers Archery · Insights" href="/rss.xml" />

    <script is:inline>
      /* Scroll reveals hide content until the motion bundle runs. Two guards,
         because a blank page is a far worse failure than a missing animation:
         .js means scripting is available at all, and the timer un-hides
         everything if motion.ts never reported in (blocked, offline, failed
         chunk, stale dev-server cache). */
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!document.documentElement.hasAttribute('data-motion-ready')) {
          document.documentElement.classList.add('motion-failed');
        }
      }, 2000);
    </script>

    <Seo {...seo} />
    <JsonLd data={graph} />
    <Analytics />
    <ClientRouter fallback="swap" />
  </head>

  <body class={bodyClasses}>
    {/* TEMPORARY pre-launch gate. Remove this line and the import on launch day. */}
    <SiteGate />

    {/* In its own landmark so axe's region rule is satisfied. */}
    <nav aria-label="Skip link"><a class="skip-link" href="#main">Skip to content</a></nav>
    <slot name="backdrop"><Backdrop scene={scene} /></slot>
    <SiteNav />
    <main id="main" class="page">
      <slot />
      <SectionLinks />
    </main>
    <Footer />
    <ActionBar hoursHref={hoursHref} />

    <script>
      // Decap CMS invite links arrive as #invite_token=… on the home page.
      if (window.location.hash.startsWith('#invite_token=') ||
          window.location.hash.startsWith('#recovery_token=')) {
        window.location.replace('/admin/' + window.location.hash);
      }
    </script>

    <script src="~/scripts/motion.ts"></script>
  </body>
</html>

<style is:global>
  /* View transition: a slow crossfade rather than a slide. */
  @view-transition { navigation: auto; }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 500ms;
    animation-timing-function: cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) { animation: none; }
  }

  /* The page is a stack of glass panels with even gaps between them. */
  .page {
    display: grid;
    /* minmax(0, 1fr), so no panel can grow wider than the screen to fit an
       unbreakable line. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--panel-gap);
    padding-top: var(--panel-gap);
  }
</style>
